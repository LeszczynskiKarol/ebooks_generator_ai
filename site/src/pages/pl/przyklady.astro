---
// PL-only examples page built around one recent book (screens, no PDF download).
// The EN /examples/ page stays removed until strong English samples exist.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { siteConfig } from "../../config/site";

import pOkladka from "../../assets/psy-mgr/01-okladka.webp";
import pSpis from "../../assets/psy-mgr/02-spis-tresci.webp";
import pOpener from "../../assets/psy-mgr/03-opener.webp";
import pTabela from "../../assets/psy-mgr/04-tabela-apa.webp";
import pDiagram from "../../assets/psy-mgr/05-diagram.webp";
import pHipotezy from "../../assets/psy-mgr/06-hipotezy.webp";
import pMapa from "../../assets/psy-mgr/07-mapa-testow.webp";
import pTabeleApa from "../../assets/psy-mgr/08-tabele-apa.webp";
import pObrona from "../../assets/psy-mgr/09-opener-obrona.webp";

const title = "Przykład ebooka — surowe strony z książki wygenerowanej przez AI";
const description =
  "Nieretuszowane strony z 40-stronicowego przewodnika wygenerowanego w InkMagnet: autorska okładka, pełnostronicowe otwarcia rozdziałów, tabele APA, diagramy i checklisty.";

const registerUrl = `${siteConfig.appUrl}/auth/register?lang=pl`;

const gallery = [
  { img: pOkladka, cap: "Okładka zaprojektowana pod paletę kolorów tej książki" },
  { img: pSpis, cap: "Spis treści — 16 rozdziałów z numeracją do trzeciego poziomu" },
  { img: pOpener, cap: "Pełnostronicowe otwarcie rozdziału z numerem na pasie" },
  { img: pTabela, cap: "Tabele w konwencji APA i checklisty na koniec sekcji" },
  { img: pDiagram, cap: "Rycina modelu badania i tabela operacjonalizacji" },
  { img: pHipotezy, cap: "Ramki ostrzeżeń i checklisty kontrolne przy hipotezach" },
  { img: pMapa, cap: "Mapa „hipoteza → test statystyczny” w przejrzystej tabeli" },
  { img: pTabeleApa, cap: "Rozdział o tabelach i rycinach według standardu APA" },
  { img: pObrona, cap: "Finał: pytania komisji i przygotowanie do obrony" },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "InkMagnet", item: `${siteConfig.url}/pl/` },
      { "@type": "ListItem", position: 2, name: "Przykłady", item: `${siteConfig.url}/pl/przyklady/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: `${siteConfig.url}/pl/przyklady/`,
    inLanguage: "pl",
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} translated={false}>
  <Header lang="pl" />
  <main class="pt-16">
    <div class="mx-auto max-w-7xl px-4 pb-4 pt-14 text-center sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-5xl">
        Prawdziwa książka. Surowe strony. Zero mockupów.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-600">
        Każde narzędzie obiecuje „profesjonalne ebooki". Poniżej strony z prawdziwej
        książki wygenerowanej w InkMagnet — dokładnie tak, jak wyszły z generatora,
        bez retuszu.
      </p>
    </div>

    <section class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">
        „Jak napisać pracę magisterską z psychologii" — 40 stron, 16 rozdziałów
      </h2>
      <p class="mt-3 max-w-3xl text-ink-600">
        To nie jest demo — to komercyjny przewodnik sprzedawany na
        praca-magisterska.pl, wygenerowany w jednym przebiegu: autorska okładka z
        paletą kolorów, pełnostronicowe otwarcia rozdziałów, tabele w konwencji APA,
        ryciny modeli badania, checklisty kontrolne i skład typograficzny, którego
        nie da się uzyskać eksportem z edytora tekstu.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          gallery.map((g, i) => (
            <figure>
              <div class="overflow-hidden rounded-xl border border-ink-200 shadow-md shadow-ink-900/5">
                <Image src={g.img} alt={g.cap} width={640} class="w-full" loading={i < 3 ? "eager" : "lazy"} />
              </div>
              <figcaption class="mt-2.5 text-center text-sm text-ink-600">{g.cap}</figcaption>
            </figure>
          ))
        }
      </div>

      <p class="mt-10 text-center text-sm text-ink-400">
        Wszystkie strony powyżej to surowe rendery z finalnego PDF-a. Niczego nie
        poprawialiśmy w Photoshopie.
      </p>
      <div class="mt-8 pb-16 text-center">
        <a
          href={registerUrl}
          class="inline-block rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25 transition-colors hover:bg-brand-700"
        >
          Wygeneruj własną książkę
        </a>
      </div>
    </section>
  </main>
  <Footer lang="pl" />
</BaseLayout>
