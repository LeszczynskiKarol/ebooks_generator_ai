---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ExamplesGallery from "../../components/ExamplesGallery.astro";
import ExampleBooks from "../../components/ExampleBooks.astro";
import { siteConfig } from "../../config/site";

const title = "Przykłady ebooków — prawdziwe strony z książek generowanych przez AI";
const description =
  "Nieretuszowane strony z książek wygenerowanych w InkMagnet: autorskie okładki AI, fotografie potraw, tabele, przypisy i pełny 38-stronicowy PDF do pobrania.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "InkMagnet", item: `${siteConfig.url}/pl/` },
      { "@type": "ListItem", position: 2, name: "Przykłady", item: `${siteConfig.url}/pl/przyklady/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: `${siteConfig.url}/pl/przyklady/`,
    inLanguage: "pl",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  hreflangEnPath="/examples/"
  hreflangPlPath="/pl/przyklady/"
>
  <Header lang="pl" />
  <main class="pt-16">
    <div class="mx-auto max-w-7xl px-4 pb-4 pt-14 text-center sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-5xl">
        Prawdziwe książki. Surowe strony. Zero mockupów.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-600">
        Każde narzędzie obiecuje „profesjonalne ebooki". Oceń nasze jedynym uczciwym
        sposobem: pobierz pełną, gotową książkę i przeczytaj dokładnie ten plik, który
        dostaje klient. Poniżej cała biblioteka przykładów do pobrania.
      </p>
    </div>

    <div class="py-8">
      <ExampleBooks lang="pl" />
    </div>

    <section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">
        Zajrzyj do środka — strona po stronie
      </h2>
      <p class="mt-3 max-w-3xl text-ink-600">
        Nieretuszowane strony z dwóch książek z biblioteki powyżej — okładka, skład,
        fotografie i ramki, dokładnie tak, jak wychodzą z generatora.
      </p>
    </section>
    <div class="pt-6">
      <ExamplesGallery lang="pl" />
    </div>
  </main>
  <Footer lang="pl" />
</BaseLayout>
