---
// PL-only examples page: raw pages from the two newest cookbooks (screens, no
// PDF download). Both books use the continuous item numbering ("Przepis 1…60").
// The EN /examples/ page stays removed until strong English samples exist.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { Image } from "astro:assets";
import { siteConfig } from "../../config/site";

import afOkladka from "../../assets/air-fryer/01-okladka.webp";
import afSpis from "../../assets/air-fryer/02-spis-tresci.webp";
import afOpener from "../../assets/air-fryer/03-opener.webp";
import afFoto1 from "../../assets/air-fryer/04-przepis-foto.webp";
import afFoto2 from "../../assets/air-fryer/05-przepis-foto2.webp";
import afDesery from "../../assets/air-fryer/06-przepisy-desery.webp";

import tmOkladka from "../../assets/thermomix/01-okladka.webp";
import tmSpis from "../../assets/thermomix/02-spis-tresci.webp";
import tmOpener from "../../assets/thermomix/03-opener-przepis1.webp";
import tmFoto from "../../assets/thermomix/04-foto-gulasz.webp";
import tmTablica from "../../assets/thermomix/05-przepis-tablica.webp";
import tmPlan from "../../assets/thermomix/06-plan-tygodnia.webp";

const title = "Przykłady ebooków — surowe strony z książek wygenerowanych przez AI";
const description =
  "Nieretuszowane strony z dwóch książek kucharskich wygenerowanych w InkMagnet: autorskie okładki, fotografie AI przy przepisach, ciągła numeracja przepisów, tabele i pełny skład typograficzny.";

const registerUrl = `${siteConfig.appUrl}/auth/register?lang=pl`;

const books = [
  {
    heading: "„Air fryer — 60 prostych przepisów na każdy dzień” — 56 stron, 6 rozdziałów",
    intro:
      "Pełnowymiarowa książka kucharska wygenerowana w jednym przebiegu: 60 przepisów z ciągłą numeracją (Przepis 1–60, nie 3.11.1), fotografie AI dopasowane do konkretnych potraw, ściągawki czasów i temperatur, checklisty i skład typograficzny, którego nie da się uzyskać eksportem z edytora tekstu.",
    gallery: [
      { img: afOkladka, cap: "Okładka zaprojektowana pod treść tej konkretnej książki" },
      { img: afSpis, cap: "Spis treści — przepisy numerowane ciągle przez całą książkę (35, 36… 57)" },
      { img: afOpener, cap: "Pełnostronicowe otwarcie rozdziału z numerem na pasie" },
      { img: afFoto1, cap: "Przepis 7 z fotografią AI wykonaną specjalnie do tej potrawy" },
      { img: afFoto2, cap: "Rycina przy przepisie — udka z kurczaka prosto z air fryera" },
      { img: afDesery, cap: "Rozdział deserowy — każdy przepis z pasem „PRZEPIS N”" },
    ],
  },
  {
    heading: "„Thermomix — proste obiady dla zabieganych” — 55 stron, 5 rozdziałów",
    intro:
      "Poradnik z przepisami: część podręcznikowa o funkcjach urządzenia i organizacji tygodnia przeplata się z przepisami bazowymi, które dostają własną, ciągłą numerację. Tabele porównawcze, plany tygodnia i checklisty wygenerowane razem z treścią.",
    gallery: [
      { img: tmOkladka, cap: "Okładka z paletą kolorów dobraną przez generator" },
      { img: tmSpis, cap: "Spis treści — rozdziały numerowane, przepisy z własnym licznikiem" },
      { img: tmOpener, cap: "Otwarcie rozdziału i Przepis 1 na tej samej rozkładówce" },
      { img: tmFoto, cap: "Fotografia AI przy technice wolnego gotowania" },
      { img: tmTablica, cap: "Tablica porównania czasów i Przepis 3 — krem z brokułów" },
      { img: tmPlan, cap: "Przykładowy plan obiadów na tydzień w tabeli" },
    ],
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "InkMagnet", item: `${siteConfig.url}/pl/` },
      { "@type": "ListItem", position: 2, name: "Przykłady", item: `${siteConfig.url}/pl/przyklady/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: `${siteConfig.url}/pl/przyklady/`,
    inLanguage: "pl",
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} translated={false}>
  <Header lang="pl" />
  <main class="pt-16">
    <div class="mx-auto max-w-7xl px-4 pb-4 pt-14 text-center sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-5xl">
        Prawdziwe książki. Surowe strony. Zero mockupów.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-600">
        Każde narzędzie obiecuje „profesjonalne ebooki". Poniżej strony z dwóch
        prawdziwych książek wygenerowanych w InkMagnet — dokładnie tak, jak wyszły
        z generatora, bez retuszu.
      </p>
    </div>

    {
      books.map((book, bi) => (
        <section class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 lg:px-8">
          <h2 class="font-display text-2xl font-extrabold tracking-tight text-ink-900 sm:text-3xl">
            {book.heading}
          </h2>
          <p class="mt-3 max-w-3xl text-ink-600">{book.intro}</p>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {book.gallery.map((g, i) => (
              <figure>
                <div class="overflow-hidden rounded-xl border border-ink-200 shadow-md shadow-ink-900/5">
                  <Image
                    src={g.img}
                    alt={g.cap}
                    width={640}
                    class="w-full"
                    loading={bi === 0 && i < 3 ? "eager" : "lazy"}
                  />
                </div>
                <figcaption class="mt-2.5 text-center text-sm text-ink-600">{g.cap}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      ))
    }

    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mt-10 text-center text-sm text-ink-400">
        Wszystkie strony powyżej to surowe rendery z finalnych PDF-ów. Niczego nie
        poprawialiśmy w Photoshopie.
      </p>
      <div class="mt-8 pb-16 text-center">
        <a
          href={registerUrl}
          class="inline-block rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25 transition-colors hover:bg-brand-700"
        >
          Wygeneruj własną książkę
        </a>
      </div>
    </section>
  </main>
  <Footer lang="pl" />
</BaseLayout>
