---
import BaseLayout from "../layouts/BaseLayout.astro";
import Landing from "../components/Landing.astro";
import { siteConfig } from "../config/site";
import { useTranslations } from "../i18n/ui";

const t = useTranslations("en");

const title = "InkMagnet — AI ebooks with professional typesetting";
const description =
  "Turn your expertise into a professional ebook in about an hour. AI research, writing, illustrations, cover design and print-quality PDF + EPUB. From $9.99 per book.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.url,
    logo: `${siteConfig.url}/favicon.svg`,
    email: siteConfig.email,
    ...(siteConfig.sameAs.length ? { sameAs: siteConfig.sameAs } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.name,
    url: siteConfig.url,
    inLanguage: ["en", "pl"],
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: siteConfig.name,
    applicationCategory: "DesignApplication",
    operatingSystem: "Web",
    url: siteConfig.url,
    description,
    offers: {
      "@type": "AggregateOffer",
      priceCurrency: "USD",
      lowPrice: "9.99",
      highPrice: "19.99",
      offerCount: 5,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: t.faq.items.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Landing lang="en" />
</BaseLayout>
