---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Page not found"
  description="This page does not exist."
  noindex
  translated={false}
>
  <Header lang="en" />
  <main class="flex min-h-[70vh] items-center justify-center pt-16">
    <div class="px-4 text-center">
      <p class="font-display text-7xl font-extrabold text-brand-600">404</p>
      <h1 class="mt-4 font-display text-2xl font-bold text-ink-900">Page not found</h1>
      <p class="mt-2 text-ink-600">The page you're looking for doesn't exist or has moved.</p>
      <a
        href="/"
        class="mt-8 inline-block rounded-xl bg-brand-600 px-7 py-3 text-base font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Back to home
      </a>
    </div>
  </main>
  <Footer lang="en" />
</BaseLayout>
