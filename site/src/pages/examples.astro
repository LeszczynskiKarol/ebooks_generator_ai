---
// EN examples page: full sample books (grid with PDF download), the English
// counterparts of the Polish /pl/przyklady/ originals — same design system,
// translated content.
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ExampleBooks from "../components/ExampleBooks.astro";
import { siteConfig } from "../config/site";

const title = "Example ebooks — raw pages from books generated by AI";
const description =
  "Full sample books generated with InkMagnet: bespoke covers, AI photographs matched to the content, continuous recipe/exercise numbering, tables and publisher-grade typesetting. Download every PDF.";

const registerUrl = `${siteConfig.appUrl}/auth/register?lang=en`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "InkMagnet", item: `${siteConfig.url}/` },
      { "@type": "ListItem", position: 2, name: "Examples", item: `${siteConfig.url}/examples/` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description,
    url: `${siteConfig.url}/examples/`,
    inLanguage: "en",
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd} translated={false}>
  <Header lang="en" />
  <main class="pt-16">
    <div class="mx-auto max-w-7xl px-4 pb-4 pt-14 text-center sm:px-6 lg:px-8">
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-5xl">
        Real books. Raw pages. Zero mockups.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-600">
        Every tool promises "professional ebooks". Below are complete books
        generated with InkMagnet — exactly as they came out of the generator,
        unretouched. Download any of them as a full PDF.
      </p>
    </div>

    <section class="pt-10">
      <ExampleBooks lang="en" />
    </section>

    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="mt-10 text-center text-sm text-ink-400">
        Every PDF above is the raw file produced by the generator. Nothing was
        fixed in Photoshop.
      </p>
      <div class="mt-8 pb-16 text-center">
        <a
          href={registerUrl}
          class="inline-block rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25 transition-colors hover:bg-brand-700"
        >
          Generate your own book
        </a>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</BaseLayout>
