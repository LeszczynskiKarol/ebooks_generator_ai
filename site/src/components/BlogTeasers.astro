---
// Ostatnie 3 wpisy bloga na stronie głównej (nad FAQ) — realne miniatury
// hero przez astro:assets (webp, małe szerokości), zero wpływu na LCP (lazy).
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { langPrefix, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = langPrefix(lang);

const posts = (await getCollection("blog", (b) => b.data.lang === lang && !b.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const t =
  lang === "pl"
    ? { title: "Z bloga", sub: "Praktyczne, oparte na źródłach poradniki o ebookach i publikowaniu.", all: "Wszystkie wpisy", read: "Czytaj artykuł" }
    : { title: "From the blog", sub: "Practical, source-backed guides on ebooks and publishing.", all: "All posts", read: "Read the article" };

const fmt = new Intl.DateTimeFormat(lang === "pl" ? "pl-PL" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const blogIndex = `${p}/blog/`;
---

{
  posts.length > 0 && (
    <section class="border-t border-ink-100">
      <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4">
          <div>
            <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
              {t.title}
            </h2>
            <p class="mt-3 text-lg text-ink-600">{t.sub}</p>
          </div>
          <a
            href={blogIndex}
            class="hidden shrink-0 text-sm font-semibold text-brand-600 hover:text-brand-700 sm:block"
          >
            {t.all} →
          </a>
        </div>
        <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`${blogIndex}${post.id}/`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-ink-100 bg-white transition-shadow hover:shadow-lg"
            >
              {post.data.heroImage && (
                <Image
                  src={post.data.heroImage}
                  alt={post.data.heroAlt || post.data.title}
                  widths={[420, 640, 840]}
                  sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
                  format="webp"
                  loading="lazy"
                  class="aspect-[3/2] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                />
              )}
              <div class="flex flex-1 flex-col p-6">
                <p class="text-sm text-ink-400">{fmt.format(post.data.pubDate)}</p>
                <h3 class="mt-1.5 font-display text-lg font-bold leading-snug text-ink-900 group-hover:text-brand-700">
                  {post.data.title}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm text-ink-600">{post.data.description}</p>
                <span class="mt-auto pt-4 text-sm font-semibold text-brand-600">
                  {t.read} →
                </span>
              </div>
            </a>
          ))}
        </div>
        <a
          href={blogIndex}
          class="mt-8 block text-center text-sm font-semibold text-brand-600 hover:text-brand-700 sm:hidden"
        >
          {t.all} →
        </a>
      </div>
    </section>
  )
}
