---
// Click-to-zoom lightbox for the real book-page screenshots only. Tag an <img>
// with `data-zoom` (and optional `data-zoom-src` for a higher-resolution file)
// and it opens enlarged in a smooth overlay. Vanilla JS, no deps.
---

<div id="lightbox" class="lb" aria-hidden="true">
  <button type="button" class="lb-close" aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="22" height="22">
      <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
  <div class="lb-stage"><img class="lb-img" alt="" /></div>
</div>

<script is:inline>
  (function () {
    var lb = document.getElementById("lightbox");
    if (!lb) return;
    var img = lb.querySelector(".lb-img");
    var isOpen = false;

    function show(el) {
      lb.classList.add("loading");
      img.src = el.getAttribute("data-zoom-src") || el.currentSrc || el.src;
      img.alt = el.alt || "";
      if (img.complete) lb.classList.remove("loading");
      else img.onload = function () { lb.classList.remove("loading"); };
      lb.classList.add("open");
      lb.setAttribute("aria-hidden", "false");
      document.documentElement.style.overflow = "hidden";
      isOpen = true;
    }
    function hide() {
      lb.classList.remove("open");
      lb.setAttribute("aria-hidden", "true");
      document.documentElement.style.overflow = "";
      isOpen = false;
    }
    document.addEventListener("click", function (e) {
      var z = e.target.closest("img[data-zoom]");
      if (z) { e.preventDefault(); show(z); return; }
      if (isOpen && (e.target === lb || e.target.closest(".lb-close"))) hide();
    });
    document.addEventListener("keydown", function (e) {
      if (isOpen && e.key === "Escape") hide();
    });
  })();
</script>

<style is:global>
  img[data-zoom] { cursor: zoom-in; }
  .lb {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5vh 2.5vw;
    background: rgba(15, 23, 42, 0.8);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.26s ease;
  }
  .lb.open { opacity: 1; pointer-events: auto; }
  .lb-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    transform: scale(0.94);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .lb.open .lb-stage { transform: scale(1); }
  .lb-img {
    max-width: 95vw;
    max-height: 95vh;
    width: auto;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 30px 100px rgba(0, 0, 0, 0.6);
    background: #fff;
  }
  .lb-close {
    position: fixed;
    top: 18px;
    right: 20px;
    z-index: 1;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 9999px;
    cursor: pointer;
    color: #fff;
    background: rgba(255, 255, 255, 0.16);
    transition: background 0.15s ease;
  }
  .lb-close:hover { background: rgba(255, 255, 255, 0.28); }
  @media (prefers-reduced-motion: reduce) {
    .lb, .lb-stage { transition: none; }
  }
</style>
