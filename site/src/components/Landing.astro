{
  /* Keep zł prices current with the live NBP rate (no rebuild needed). The
     build-time value is the instant fallback; this refreshes it client-side. */
  isPL && (
    <script is:inline>
      (function () {
        var els = document.querySelectorAll(".js-zl[data-usd]");
        if (!els.length) return;
        function apply(rate) {
          els.forEach(function (el) {
            var usd = parseFloat(el.getAttribute("data-usd"));
            if (!isFinite(usd)) return;
            el.textContent =
              (usd * rate).toLocaleString("pl-PL", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
              }) + " zł";
          });
        }
        try {
          var c = JSON.parse(sessionStorage.getItem("im_nbp_usd_pln") || "null");
          if (c && c.rate && Date.now() - c.t < 15 * 60 * 1000) {
            apply(c.rate);
            return;
          }
        } catch (e) {}
        fetch("https://api.nbp.pl/api/exchangerates/rates/a/usd/?format=json")
          .then(function (r) { return r.json(); })
          .then(function (d) {
            var rate = d.rates[0].mid;
            apply(rate);
            try {
              sessionStorage.setItem(
                "im_nbp_usd_pln",
                JSON.stringify({ rate: rate, t: Date.now() }),
              );
            } catch (e) {}
          })
          .catch(function () {});
      })();
    </script>
  )
