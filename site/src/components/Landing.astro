---
import { siteConfig } from "../config/site";
import { useTranslations, langPrefix, type Lang } from "../i18n/ui";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import StepMock from "./mock/StepMock.astro";
import PageMock from "./mock/PageMock.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = langPrefix(lang);
const registerUrl = `${siteConfig.appUrl}/auth/register`;

const featureIcons = [
  // globe / research
  "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-18c2.5 2.5 3.9 5.6 3.9 9S14.5 18.5 12 21m0-18C9.5 5.5 8.1 8.6 8.1 12s1.4 6.5 3.9 9M3.5 9h17M3.5 15h17",
  // book-open / typesetting
  "M12 6.25c-2-1.5-4.6-2.25-7.5-2.25v14c2.9 0 5.5.75 7.5 2.25m0-14c2-1.5 4.6-2.25 7.5-2.25v14c-2.9 0-5.5.75-7.5 2.25m0-14v14",
  // photo / illustrations
  "M3 16.5 8 11l4.5 4.5m0 0L16 12l5 5M3.75 19.5h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5ZM9 8.25h.008v.008H9V8.25Z",
  // sparkles / cover
  "M9.8 15.9 9 18.8l-.8-2.9a4 4 0 0 0-2.8-2.8L2.5 12l2.9-.8a4 4 0 0 0 2.8-2.8L9 5.5l.8 2.9a4 4 0 0 0 2.8 2.8l2.9.8-2.9.8a4 4 0 0 0-2.8 2.8ZM17.5 8l-.4 1.5L16.7 8a2.6 2.6 0 0 0-1.8-1.8L13.5 6l1.4-.4a2.6 2.6 0 0 0 1.8-1.8l.4-1.4.4 1.4a2.6 2.6 0 0 0 1.8 1.8l1.4.4-1.4.4A2.6 2.6 0 0 0 17.5 8ZM19 17.2l-.6 2.3-.6-2.3a2 2 0 0 0-1.5-1.5l-2.3-.6 2.3-.6a2 2 0 0 0 1.5-1.5l.6-2.3.6 2.3a2 2 0 0 0 1.5 1.5l2.3.6-2.3.6a2 2 0 0 0-1.5 1.5Z",
  // pencil / edits
  "m16.9 4.5 2.7 2.6M3.7 20.3l3.8-.8c.2 0 .4-.1.5-.3L19.6 7.6a1.9 1.9 0 0 0 0-2.6l-.6-.6a1.9 1.9 0 0 0-2.7 0L4.7 16a.9.9 0 0 0-.3.5l-.8 3.8Z",
  // arrow-down-tray / formats
  "M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3",
];

const useCaseIcons = [
  "M6 3v8a6 6 0 0 0 12 0V3M6 3h4v8a2 2 0 0 0 4 0V3h4M6 7h4m4 0h4",
  "M4.3 9.7 12 5.5l7.7 4.2L12 13.9 4.3 9.7Zm0 0V15m3-3.6v4.3c0 .6 2.1 2.3 4.7 2.3s4.7-1.7 4.7-2.3v-4.3",
  "M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.1a7.5 7.5 0 0 1 15 0 17 17 0 0 1-7.5 1.7c-2.7 0-5.2-.6-7.5-1.7Z",
  "M20.25 14.15v4.07a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25v-4.07M12 13.875h.008v.008H12v-.008Zm8.25-4.625v2.625a2.25 2.25 0 0 1-1.5 2.122 48.6 48.6 0 0 1-13.5 0 2.25 2.25 0 0 1-1.5-2.122V9.25A2.25 2.25 0 0 1 6 7h12a2.25 2.25 0 0 1 2.25 2.25ZM9 7V5.25A2.25 2.25 0 0 1 11.25 3h1.5A2.25 2.25 0 0 1 15 5.25V7",
];
---

<Header lang={lang} />

<main class="pt-16">
  <!-- ━━━ Hero ━━━ -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_30rem_at_70%_-10%,theme(colors.brand.100),transparent)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto grid max-w-7xl gap-12 px-4 pb-20 pt-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-8 lg:px-8 lg:pb-28 lg:pt-24">
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-brand-600" aria-hidden="true"></span>
          {t.hero.badge}
        </p>
        <h1 class="mt-5 font-display text-4xl font-extrabold leading-[1.1] tracking-tight text-ink-900 sm:text-5xl lg:text-[3.4rem]">
          {t.hero.title1}
          <span class="text-brand-600">{t.hero.titleAccent}</span>
          {t.hero.title2}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600">{t.hero.sub}</p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href={registerUrl}
            class="rounded-xl bg-brand-600 px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25 transition-colors hover:bg-brand-700"
          >
            {t.hero.ctaPrimary}
          </a>
          <a
            href={`${p}/#how`}
            class="rounded-xl border border-ink-200 bg-white px-7 py-3.5 text-base font-semibold text-ink-700 transition-colors hover:border-ink-300 hover:bg-ink-50"
          >
            {t.hero.ctaSecondary}
          </a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-600">
          {
            t.hero.bullets.map((b) => (
              <li class="flex items-center gap-2">
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 text-brand-600" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.8a1 1 0 0 1 1.4 0Z"
                    clip-rule="evenodd"
                  />
                </svg>
                {b}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Generated cover + inside page — rendered UI mockup (locale-neutral) -->
      <div class="relative mx-auto w-full max-w-md lg:max-w-none" aria-hidden="true">
        <div class="relative mx-auto h-[420px] w-[340px] sm:h-[470px] sm:w-[400px]">
          <!-- inside page -->
          <div class="absolute left-0 top-8 w-52 -rotate-3 rounded-lg border border-ink-200 bg-white p-4 shadow-xl shadow-ink-900/10 sm:w-60">
            <div class="mb-1 h-1.5 w-8 rounded bg-brand-300"></div>
            <div class="mb-3 h-2.5 w-3/4 rounded bg-ink-300"></div>
            <div class="flex gap-1.5">
              <div class="h-8 w-8 flex-shrink-0 rounded bg-brand-600"></div>
              <div class="flex-1 space-y-1 pt-0.5">
                <div class="h-1.5 w-full rounded bg-ink-100"></div>
                <div class="h-1.5 w-full rounded bg-ink-100"></div>
                <div class="h-1.5 w-10/12 rounded bg-ink-100"></div>
              </div>
            </div>
            <div class="mt-2 space-y-1.5">
              <div class="h-1.5 w-full rounded bg-ink-100"></div>
              <div class="h-1.5 w-11/12 rounded bg-ink-100"></div>
              <div class="h-1.5 w-full rounded bg-ink-100"></div>
              <div class="h-1.5 w-3/4 rounded bg-ink-100"></div>
            </div>
          </div>
          <!-- cover -->
          <div class="absolute right-0 top-0 flex h-80 w-56 rotate-2 flex-col justify-between rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 p-5 shadow-2xl shadow-ink-900/30 sm:h-96 sm:w-64">
            <div class="h-1.5 w-16 rounded-full bg-white/40"></div>
            <div class="space-y-2">
              <div class="h-3 w-4/5 rounded bg-white/90"></div>
              <div class="h-3 w-3/5 rounded bg-white/90"></div>
              <div class="mt-3 h-1.5 w-24 rounded bg-white/50"></div>
            </div>
            <div class="h-2 w-20 rounded bg-white/30"></div>
          </div>
        </div>
        <div class="absolute -bottom-3 left-1/2 flex -translate-x-1/2 items-center gap-2 rounded-full border border-ink-100 bg-white px-4 py-2 text-xs font-semibold text-ink-700 shadow-lg">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 text-brand-600" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          PDF · EPUB
        </div>
      </div>
    </div>
  </section>

  <!-- ━━━ How it works — real app screens ━━━ -->
  <section id="how" class="scroll-mt-20 border-t border-ink-100 bg-ink-50">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          {t.how.title}
        </h2>
        <p class="mt-4 text-lg text-ink-600">{t.how.sub}</p>
      </div>

      <ol class="mt-16 space-y-16">
        {
          t.how.steps.map((step, i) => (
            <li class={`grid items-center gap-8 lg:grid-cols-2 lg:gap-14 ${i % 2 === 1 ? "lg:[&>div:first-child]:order-2" : ""}`}>
              <div>
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-600 font-display text-base font-bold text-white">
                  {i + 1}
                </span>
                <h3 class="mt-4 font-display text-2xl font-bold text-ink-900">{step.title}</h3>
                <p class="mt-3 max-w-md leading-relaxed text-ink-600">{step.desc}</p>
              </div>
              <div class="rounded-2xl border border-ink-200 bg-white p-2 shadow-lg shadow-ink-900/5">
                <StepMock i={i} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ━━━ Deep dive — why it's more than a chatbot ━━━ -->
  <section class="border-t border-ink-100">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          {t.deepDive.title}
        </h2>
        <p class="mt-4 text-lg text-ink-600">{t.deepDive.sub}</p>
      </div>
      <div class="mt-14 grid gap-6 lg:grid-cols-3 lg:gap-8">
        {
          t.deepDive.items.map((it, i) => (
            <div class="rounded-2xl border border-ink-100 bg-ink-50/50 p-7">
              <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 font-display text-sm font-bold text-white">
                {i + 1}
              </span>
              <h3 class="mt-4 font-display text-xl font-bold text-ink-900">{it.title}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-ink-600">{it.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ━━━ Real pages gallery ━━━ -->
  <section class="border-t border-ink-100">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          {t.gallery.title}
        </h2>
        <p class="mt-4 text-lg text-ink-600">{t.gallery.sub}</p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          t.gallery.items.map((item, i) => (
            <figure class="group">
              <div class="overflow-hidden rounded-xl border border-ink-200 shadow-md shadow-ink-900/5 transition-shadow group-hover:shadow-xl">
                <PageMock kind={i} />
              </div>
              <figcaption class="mt-3 text-center text-sm font-medium text-ink-700">
                {item.caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="mt-8 text-center text-xs text-ink-400">{t.gallery.note}</p>
    </div>
  </section>

  <!-- ━━━ Features ━━━ -->
  <section id="features" class="scroll-mt-20 border-t border-ink-100 bg-ink-50">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          {t.features.title}
        </h2>
        <p class="mt-4 text-lg text-ink-600">{t.features.sub}</p>
      </div>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          t.features.items.map((f, i) => (
            <div class="rounded-2xl border border-ink-100 bg-white p-6 transition-shadow hover:shadow-md">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-6 w-6" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={featureIcons[i]} />
                </svg>
              </span>
              <h3 class="mt-4 font-display text-lg font-bold text-ink-900">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-600">{f.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ━━━ Compare — vs raw ChatGPT / Claude ━━━ -->
  <section class="border-t border-ink-100 bg-ink-50">
    <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          {t.compare.title}
        </h2>
        <p class="mt-4 text-lg text-ink-600">{t.compare.sub}</p>
      </div>

      <div class="mt-12 overflow-x-auto rounded-2xl border border-ink-200 bg-white shadow-sm">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead>
            <tr class="border-b border-ink-100">
              <th class="px-4 py-4 sm:px-6" />
              <th class="px-4 py-4 font-display text-sm font-bold text-ink-500 sm:px-6">{t.compare.colA}</th>
              <th class="bg-brand-50/60 px-4 py-4 font-display text-sm font-bold text-brand-700 sm:px-6">
                <span class="inline-flex items-center gap-1.5">
                  <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L4.3 10.7a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" /></svg>
                  {t.compare.colB}
                </span>
              </th>
            </tr>
          </thead>
          <tbody>
            {
              t.compare.rows.map((r, i) => (
                <tr class={i % 2 ? "bg-ink-50/40" : "bg-white"}>
                  <td class="px-4 py-3.5 font-semibold text-ink-900 sm:px-6">{r.label}</td>
                  <td class="px-4 py-3.5 align-top text-ink-500 sm:px-6">
                    <span class="flex items-start gap-2">
                      <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 flex-shrink-0 text-ink-300"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.3 7.2a1 1 0 0 0-1.4 1.4L8.6 10l-1.7 1.7a1 1 0 1 0 1.4 1.4L10 11.4l1.7 1.7a1 1 0 0 0 1.4-1.4L11.4 10l1.7-1.7a1 1 0 0 0-1.4-1.4L10 8.6 8.3 7.2Z" clip-rule="evenodd" /></svg>
                      {r.a}
                    </span>
                  </td>
                  <td class="bg-brand-50/40 px-4 py-3.5 align-top text-ink-700 sm:px-6">
                    <span class="flex items-start gap-2">
                      <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-600"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L4.3 10.7a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" /></svg>
                      {r.b}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mx-auto mt-8 max-w-2xl text-center text-[15px] leading-relaxed text-ink-600">{t.compare.note}</p>
      <div class="mt-8 text-center">
        <a
          href={registerUrl}
          class="inline-block rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25 transition-colors hover:bg-brand-700"
        >
          {t.hero.ctaPrimary}
        </a>
      </div>
    </div>
  </section>

  <!-- ━━━ App showcase — real dashboard ━━━ -->
  <section class="border-t border-ink-100">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          {t.appShowcase.title}
        </h2>
        <p class="mt-4 text-lg text-ink-600">{t.appShowcase.sub}</p>
      </div>
      <div class="mt-12 overflow-hidden rounded-2xl border border-ink-200 shadow-2xl shadow-ink-900/10">
        <div class="flex items-center gap-1.5 border-b border-ink-100 bg-ink-50 px-4 py-3" aria-hidden="true">
          <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
          <span class="ml-3 hidden rounded-md bg-white px-3 py-1 text-xs text-ink-400 sm:block">app.inkmagnet.com</span>
        </div>
        <div class="grid grid-cols-[0_1fr] bg-white sm:grid-cols-[160px_1fr]">
          <!-- sidebar -->
          <aside class="hidden flex-col gap-6 border-r border-ink-100 bg-ink-50 p-5 sm:flex">
            <div class="h-3 w-24 rounded bg-brand-600"></div>
            <nav class="space-y-2.5">
              <div class="flex items-center gap-2 rounded-lg bg-brand-100 px-2.5 py-2 ring-1 ring-brand-200">
                <span class="h-3 w-3 rounded bg-brand-500"></span>
                <span class="h-2 w-16 rounded bg-brand-300"></span>
              </div>
              {[18, 14, 20].map((w) => (
                <div class="flex items-center gap-2 px-2.5 py-2">
                  <span class="h-3 w-3 rounded bg-ink-200"></span>
                  <span class="h-2 rounded bg-ink-200" style={`width:${w * 4}px`}></span>
                </div>
              ))}
            </nav>
          </aside>
          <!-- book grid -->
          <div class="p-5 sm:p-7">
            <div class="mb-5 flex items-center justify-between">
              <div class="h-3.5 w-32 rounded bg-ink-300"></div>
              <div class="flex h-9 w-32 items-center justify-center gap-1.5 rounded-lg bg-brand-600">
                <span class="h-3 w-3 rounded-full border-2 border-white"></span>
                <span class="h-2 w-14 rounded bg-white/70"></span>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
              {
                [
                  { g: "from-brand-500 to-brand-700", s: "bg-green-100", d: "bg-green-500" },
                  { g: "from-emerald-500 to-teal-700", s: "bg-green-100", d: "bg-green-500" },
                  { g: "from-rose-500 to-orange-700", s: "bg-brand-100", d: "bg-brand-500" },
                  { g: "from-indigo-500 to-violet-700", s: "bg-green-100", d: "bg-green-500" },
                  { g: "from-amber-500 to-rose-700", s: "bg-amber-100", d: "bg-amber-500" },
                  { g: "from-sky-500 to-blue-700", s: "bg-green-100", d: "bg-green-500" },
                  { g: "from-fuchsia-500 to-purple-700", s: "bg-green-100", d: "bg-green-500" },
                  { g: "from-lime-500 to-emerald-700", s: "bg-brand-100", d: "bg-brand-500" },
                ].map((c) => (
                  <div class="overflow-hidden rounded-xl border border-ink-100 bg-white shadow-sm">
                    <div class={`flex aspect-[3/4] flex-col justify-between bg-gradient-to-br ${c.g} p-3`}>
                      <div class="h-1 w-8 rounded-full bg-white/40"></div>
                      <div class="space-y-1">
                        <div class="h-1.5 w-4/5 rounded bg-white/90"></div>
                        <div class="h-1.5 w-3/5 rounded bg-white/90"></div>
                      </div>
                      <div class="h-1 w-6 rounded bg-white/30"></div>
                    </div>
                    <div class="flex items-center justify-between p-2.5">
                      <span class="h-2 w-12 rounded bg-ink-200"></span>
                      <span class={`flex h-4 w-4 items-center justify-center rounded-full ${c.s}`}>
                        <span class={`h-2 w-2 rounded-full ${c.d}`}></span>
                      </span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ━━━ Use cases ━━━ -->
  <section class="border-t border-ink-100 bg-ink-950">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <h2 class="text-center font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        {t.useCases.title}
      </h2>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          t.useCases.items.map((u, i) => (
            <div class="rounded-2xl border border-ink-800 bg-ink-900 p-6">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-600/15 text-brand-400">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-6 w-6" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={useCaseIcons[i]} />
                </svg>
              </span>
              <h3 class="mt-4 font-display text-lg font-bold text-white">{u.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-400">{u.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ━━━ Pricing ━━━ -->
  <section id="pricing" class="scroll-mt-20">
    <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          {t.pricing.title}
        </h2>
        <p class="mt-4 text-lg text-ink-600">{t.pricing.sub}</p>
      </div>

      <div class="mt-14 overflow-hidden rounded-2xl border border-ink-100 shadow-sm">
        <table class="w-full text-left">
          <caption class="sr-only">{t.pricing.title}</caption>
          <tbody>
            {
              t.pricing.tiers.map((tier, i) => (
                <tr class={i % 2 === 0 ? "bg-white" : "bg-ink-50"}>
                  <td class="px-5 py-4 font-display text-base font-bold text-ink-900 sm:px-8">
                    {tier.label}
                  </td>
                  <td class="px-5 py-4 text-sm text-ink-600 sm:px-8">
                    {tier.pages} {t.pricing.pages}
                  </td>
                  <td class="px-5 py-4 text-right sm:px-8">
                    <span class="font-display text-xl font-extrabold text-brand-600">{tier.price}</span>
                    <span class="ml-1 text-xs text-ink-500">{t.pricing.perBook}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-6 text-center text-sm text-ink-500">{t.pricing.note}</p>
      <div class="mt-8 text-center">
        <a
          href={registerUrl}
          class="inline-block rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25 transition-colors hover:bg-brand-700"
        >
          {t.pricing.cta}
        </a>
      </div>
    </div>
  </section>

  <!-- ━━━ FAQ ━━━ -->
  <section id="faq" class="scroll-mt-20 border-t border-ink-100 bg-ink-50">
    <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <h2 class="text-center font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        {t.faq.title}
      </h2>
      <div class="mt-12 space-y-4">
        {
          t.faq.items.map((item) => (
            <details class="group rounded-2xl border border-ink-100 bg-white p-6 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-base font-bold text-ink-900">
                {item.q}
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="h-5 w-5 shrink-0 text-ink-400 transition-transform group-open:rotate-180"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </summary>
              <p class="mt-4 text-sm leading-relaxed text-ink-600">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ━━━ Final CTA ━━━ -->
  <section class="bg-brand-700">
    <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        {t.finalCta.title}
      </h2>
      <p class="mt-4 text-lg text-brand-100">{t.finalCta.sub}</p>
      <a
        href={registerUrl}
        class="mt-8 inline-block rounded-xl bg-white px-8 py-3.5 text-base font-semibold text-brand-700 shadow-lg transition-colors hover:bg-brand-50"
      >
        {t.finalCta.cta}
      </a>
    </div>
  </section>
</main>

<Footer lang={lang} />
