---
// Dedicated landing page for the Android app, EN + PL. Mirrors Landing.astro:
// the page files stay thin and everything localized comes from i18n/ui.ts.
import { useTranslations, langPrefix, type Lang } from "../i18n/ui";
import { playHref } from "../lib/play";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import PhoneMock from "./mock/PhoneMock.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const a = t.appPage;
const p = langPrefix(lang);
const isPL = lang === "pl";

const heroHref = playHref(lang, "app-landing-hero");
const finalHref = playHref(lang, "app-landing-final");
const badge = isPL ? "/badges/google-play-pl.png" : "/badges/google-play-en.png";
const examplesHref = isPL ? "/pl/przyklady/" : "/examples/";

const screens = ["books", "create", "detail"] as const;

const whyIcons = [
  // clock
  "M12 6v6l4 2m6-2a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z",
  // check-badge
  "m9 12.75 2.25 2.25 4.5-4.5M21 12a2.6 2.6 0 0 0-1.2-2.2 2.6 2.6 0 0 1-1-2.5 2.6 2.6 0 0 0-1.8-2 2.6 2.6 0 0 1-1.9-1.8 2.6 2.6 0 0 0-2.5-1 2.6 2.6 0 0 1-2.4-1 2.6 2.6 0 0 0-2.4 1 2.6 2.6 0 0 1-2.5 1 2.6 2.6 0 0 0-1.8 2A2.6 2.6 0 0 1 4.2 9.8 2.6 2.6 0 0 0 3 12a2.6 2.6 0 0 0 1.2 2.2 2.6 2.6 0 0 1 1 2.5 2.6 2.6 0 0 0 1.8 2 2.6 2.6 0 0 1 1.9 1.8 2.6 2.6 0 0 0 2.5 1 2.6 2.6 0 0 1 2.4 1 2.6 2.6 0 0 0 2.4-1 2.6 2.6 0 0 1 2.5-1 2.6 2.6 0 0 0 1.8-2 2.6 2.6 0 0 1 1.9-1.8A2.6 2.6 0 0 0 21 12Z",
  // book-open
  "M12 6.25c-2-1.5-4.6-2.25-7.5-2.25v14c2.9 0 5.5.75 7.5 2.25m0-14c2-1.5 4.6-2.25 7.5-2.25v14c-2.9 0-5.5.75-7.5 2.25m0-14v14",
  // credit-card
  "M2.25 8.25h19.5M2.25 9h19.5m-16.5 6h6m-6 2.25h3M3.75 6h16.5a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5H3.75a1.5 1.5 0 0 1-1.5-1.5v-9A1.5 1.5 0 0 1 3.75 6Z",
];
---

<Header lang={lang} />

<main class="pt-16">
  <!-- ━━━ Hero ━━━ -->
  <section class="relative overflow-hidden bg-ink-950">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(55rem_28rem_at_75%_-15%,rgba(99,102,241,0.28),transparent)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative mx-auto grid max-w-7xl gap-14 px-4 pb-20 pt-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-10 lg:px-8 lg:pb-24 lg:pt-20"
    >
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
            <path d="M3.6 20.6 12 12 3.6 3.4a1.6 1.6 0 0 0-.6 1.3v14.6c0 .5.2 1 .6 1.3Zm10-7.3 2.4 2.4-8.6 4.9 6.2-7.3Zm0-2.6L7.4 3.4l8.6 4.9-2.4 2.4Zm3.9 3.9-2.7-2.6 2.7-2.6 3 1.7c.8.5.8 1.4 0 1.9l-3 1.6Z"></path>
          </svg>
          {a.badge}
        </p>
        <h1
          class="mt-5 font-display text-4xl font-extrabold leading-[1.1] tracking-tight text-white sm:text-5xl"
        >
          {a.title1}{" "}
          <span class="text-brand-400">{a.titleAccent}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-300">{a.sub}</p>

        <div class="mt-8 flex flex-wrap items-center gap-5">
          <a href={heroHref} rel="noopener" class="inline-block transition-opacity hover:opacity-90">
            <img src={badge} alt={t.appPromo.cta} width="194" height="75" decoding="async" />
          </a>
          <a
            href={examplesHref}
            class="text-sm font-semibold text-brand-300 underline-offset-4 transition-colors hover:text-brand-200 hover:underline"
          >
            {a.ctaSecondary} &rarr;
          </a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-300">
          {
            a.bullets.map((b) => (
              <li class="flex items-center gap-2">
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 text-brand-400" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                </svg>
                {b}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex justify-center lg:justify-end">
        <PhoneMock lang={lang} screen="create" class="rotate-[2deg]" />
      </div>
    </div>
  </section>

  <!-- ━━━ The three screens ━━━ -->
  <section class="border-t border-ink-100 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          {a.screens.title}
        </h2>
        <p class="mt-4 text-lg text-ink-600">{a.screens.sub}</p>
      </div>

      <div class="mt-14 grid gap-12 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
        {
          a.screens.items.map((item, i) => (
            <figure class="flex flex-col items-center text-center">
              <PhoneMock lang={lang} screen={screens[i]} />
              <figcaption class="mt-7 max-w-sm">
                <h3 class="font-display text-lg font-bold text-ink-900">{item.title}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-ink-600">{item.text}</p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ━━━ Why on a phone ━━━ -->
  <section class="border-t border-ink-100 bg-ink-50">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          {a.why.title}
        </h2>
        <p class="mt-4 text-lg text-ink-600">{a.why.sub}</p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {
          a.why.items.map((item, i) => (
            <div class="rounded-2xl border border-ink-200 bg-white p-6 shadow-sm">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-6 w-6" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={whyIcons[i]} />
                </svg>
              </span>
              <h3 class="mt-4 font-display text-lg font-bold text-ink-900">{item.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-600">{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ━━━ App vs web ━━━ -->
  <section class="border-t border-ink-100 bg-white">
    <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          {a.split.title}
        </h2>
        <p class="mt-4 text-lg text-ink-600">{a.split.sub}</p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          [
            { title: a.split.appTitle, items: a.split.appItems, accent: true },
            { title: a.split.webTitle, items: a.split.webItems, accent: false },
          ].map((col) => (
            <div
              class={`rounded-2xl border p-7 ${col.accent ? "border-brand-200 bg-brand-50/50" : "border-ink-200 bg-ink-50"}`}
            >
              <h3 class="flex items-center gap-2.5 font-display text-lg font-bold text-ink-900">
                <span
                  class={`flex h-8 w-8 items-center justify-center rounded-lg ${col.accent ? "bg-brand-600 text-white" : "bg-ink-200 text-ink-700"}`}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-4.5 w-4.5" aria-hidden="true">
                    {col.accent ? (
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5h3m-6.75 21h10.5a1.5 1.5 0 0 0 1.5-1.5V3a1.5 1.5 0 0 0-1.5-1.5H6.75A1.5 1.5 0 0 0 5.25 3v18a1.5 1.5 0 0 0 1.5 1.5Z" />
                    ) : (
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12v9a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 14.25v-9A2.25 2.25 0 0 1 5.25 3h13.5A2.25 2.25 0 0 1 21 5.25Z" />
                    )}
                  </svg>
                </span>
                {col.title}
              </h3>
              <ul class="mt-5 space-y-3">
                {col.items.map((it) => (
                  <li class="flex items-start gap-2.5 text-[15px] text-ink-700">
                    <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 flex-shrink-0 text-brand-600">
                      <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L4.3 10.7a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                    </svg>
                    {it}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="mt-7 text-center text-sm font-medium text-ink-500">{a.split.note}</p>
    </div>
  </section>

  <!-- ━━━ Pricing note ━━━ -->
  <section class="border-t border-ink-100 bg-ink-50">
    <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        {a.price.title}
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-600">{a.price.body}</p>
      <a
        href={`${p}/#pricing`}
        class="mt-7 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 underline-offset-4 hover:underline"
      >
        {t.nav.pricing} &rarr;
      </a>
    </div>
  </section>

  <!-- ━━━ FAQ ━━━ -->
  <section class="border-t border-ink-100 bg-white">
    <div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
      <h2
        class="text-center font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl"
      >
        {a.faq.title}
      </h2>
      <dl class="mt-12 divide-y divide-ink-100 border-y border-ink-100">
        {
          a.faq.items.map((f) => (
            <div class="py-6">
              <dt class="font-display text-base font-bold text-ink-900">{f.q}</dt>
              <dd class="mt-2 text-[15px] leading-relaxed text-ink-600">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ━━━ Final CTA ━━━ -->
  <section class="border-t border-ink-100 bg-ink-950">
    <div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:px-8 lg:py-24">
      <h2 class="font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        {a.final.title}
      </h2>
      <p class="mt-4 text-lg text-ink-300">{a.final.sub}</p>
      <a
        href={finalHref}
        rel="noopener"
        class="mt-9 inline-block transition-opacity hover:opacity-90"
      >
        <img
          src={badge}
          alt={t.appPromo.cta}
          width="194"
          height="75"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="mt-6 text-xs text-ink-500">{t.appPromo.note}</p>
    </div>
  </section>
</main>

<Footer lang={lang} />
