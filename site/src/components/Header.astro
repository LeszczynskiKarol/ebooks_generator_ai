---
import { siteConfig } from "../config/site";
import { useTranslations, langPrefix, deAlternates, deToEnPaths, type Lang } from "../i18n/ui";
import { appPagePath } from "../lib/play";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = langPrefix(lang);

// Language switch.
//  - PL and DE pages: always one visible "EN" link.
//  - EN pages: "PL" (same page under /pl/) and "DE" (only where a German
//    counterpart exists) are in the HTML but hidden; the inline script below
//    reveals each one only if the browser languages include that language.
const path = Astro.url.pathname;
const withSlash = path.endsWith("/") ? path : `${path}/`;
const enPath = lang === "de" ? (deToEnPaths[withSlash] ?? "/") : path.replace(/^\/pl(\/|$)/, "/");
const dePath: string | undefined = lang === "en" ? deAlternates[withSlash] : undefined;
const switchLabels: Record<Lang, string> = {
  en: "English version",
  pl: "Wersja polska",
  de: "Deutsche Version",
};
const switchLinks: { to: Lang; href: string; auto: boolean }[] =
  lang === "en"
    ? [
        { to: "pl" as Lang, href: enPath === "/" ? "/pl/" : `/pl${enPath}`, auto: true },
        ...(dePath ? [{ to: "de" as Lang, href: dePath, auto: true }] : []),
      ]
    : [{ to: "en" as Lang, href: enPath, auto: false }];
const themeLabel =
  lang === "pl"
    ? "Przełącz motyw jasny/ciemny"
    : lang === "de"
      ? "Zwischen hellem und dunklem Design wechseln"
      : "Toggle light/dark theme";

// carry the language into the app so login/registration open in the right one
// ALWAYS explicit — without ?lang=en the app falls back to navigator.language
// and a Polish-browser visitor reading the ENGLISH site got a Polish app.
const appQ = `?lang=${lang}`;

// German (v1) has no examples gallery, blog or app page: link only what exists.
const navItems: { href: string; label: string; lgOnly?: boolean }[] = lang === "de" ? [
  { href: "/de/#how", label: t.nav.how },
  { href: "/de/#features", label: t.nav.features },
  { href: "/de/#pricing", label: t.nav.pricing },
  { href: "/de/#faq", label: t.nav.faq },
] : [
  { href: `${p}/#how`, label: t.nav.how },
  ...(lang === "pl"
    ? [{ href: "/pl/przyklady/", label: t.nav.examples }]
    : [{ href: "/examples/", label: t.nav.examples }]),
  { href: `${p}/#pricing`, label: t.nav.pricing },
  { href: lang === "pl" ? "/pl/blog/" : "/blog/", label: t.nav.blog },
  // only from lg up — five items plus the CTA buttons overflow a md viewport
  { href: appPagePath(lang), label: t.nav.app, lgOnly: true },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-ink-100 bg-white/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href={lang === "de" ? "/de/" : p || "/"} class="flex items-center gap-2.5">
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600">
        <svg viewBox="0 0 24 24" fill="none" class="h-5 w-5 text-white" aria-hidden="true">
          <path
            d="M12 3c3.5 4.2 5.5 7.2 5.5 9.8a5.5 5.5 0 1 1-11 0C6.5 10.2 8.5 7.2 12 3Z"
            fill="currentColor"
          />
        </svg>
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-display text-lg font-bold tracking-tight text-ink-900">InkMagnet</span>
        <span class="mt-0.5 text-[10px] font-semibold uppercase tracking-[0.18em] text-brand-600/90">{t.nav.tagline}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label={lang === "de" ? "Hauptnavigation" : "Main"}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-sm font-medium text-ink-600 transition-colors hover:text-ink-900",
              item.lgOnly && "hidden lg:inline",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-4">
      <button
        id="theme-toggle"
        type="button"
        aria-label={themeLabel}
        class="rounded-lg p-2 text-ink-500 transition-colors hover:bg-ink-100 hover:text-ink-900"
      >
        {/* księżyc w jasnym motywie, słońce w ciemnym */}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5 dark:hidden" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8Z" />
        </svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="hidden h-5 w-5 dark:block" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      {
        switchLinks.map((l) => (
          <a
            href={l.href}
            data-langswitch={l.to}
            data-langswitch-auto={l.auto ? l.to : undefined}
            hidden={l.auto}
            class="rounded-lg px-2 py-1 text-sm font-semibold text-ink-500 transition-colors hover:bg-ink-100 hover:text-ink-900"
            aria-label={switchLabels[l.to]}
          >
            {l.to.toUpperCase()}
          </a>
        ))
      }
      {
        /* Runs right after the links, before first paint: no flash, no shift.
           Without JS the links simply stay hidden. */
        lang === "en" && (
          <script is:inline>
            (function () {
              try {
                var n = navigator;
                var langs = n.languages && n.languages.length ? n.languages : [n.language || n.userLanguage || ""];
                var links = document.querySelectorAll("a[data-langswitch-auto]");
                for (var i = 0; i < links.length; i++) {
                  var code = links[i].getAttribute("data-langswitch-auto");
                  for (var j = 0; j < langs.length; j++) {
                    if (String(langs[j] || "").toLowerCase().indexOf(code) === 0) {
                      links[i].removeAttribute("hidden");
                      break;
                    }
                  }
                }
              } catch (e) {}
            })();
          </script>
        )
      }
      <a
        href={`${siteConfig.appUrl}/auth/login${appQ}`}
        class="hidden text-sm font-medium text-ink-600 transition-colors hover:text-ink-900 sm:block"
      >
        {t.nav.signIn}
      </a>
      <a
        href={`${siteConfig.appUrl}/auth/register${appQ}`}
        class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
      >
        {t.nav.cta}
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var dark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("im-theme", dark ? "dark" : "light");
      } catch (e) {}
    });
  })();
</script>
