---
// Homepage band announcing the Android app. Deliberately dark so it reads as a
// separate product moment between the two white web-app sections.
import { useTranslations, type Lang } from "../i18n/ui";
import { playHref, appPagePath } from "../lib/play";
import PhoneMock from "./mock/PhoneMock.astro";

interface Props {
  lang: Lang;
  campaign?: string;
}
const { lang, campaign = "home-band" } = Astro.props;
const t = useTranslations(lang);
const a = t.appPromo;
const href = playHref(lang, campaign);
const badge = lang === "pl" ? "/badges/google-play-pl.png" : "/badges/google-play-en.png";
---

<section id="app" class="theme-fixed scroll-mt-20 border-t border-ink-100 bg-ink-950">
  <div
    class="mx-auto grid max-w-7xl items-center gap-14 px-4 py-20 sm:px-6 lg:grid-cols-2 lg:gap-10 lg:px-8 lg:py-24"
  >
    <div>
      <p
        class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-300"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-brand-400" aria-hidden="true"></span>
        {a.badge}
      </p>
      <h2
        class="mt-5 font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl"
      >
        {a.title}
      </h2>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-ink-300">{a.sub}</p>

      <ul class="mt-7 space-y-3">
        {
          a.points.map((pt) => (
            <li class="flex items-start gap-3 text-[15px] text-ink-200">
              <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 flex-shrink-0 text-brand-400" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L4.3 10.7a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
              </svg>
              {pt}
            </li>
          ))
        }
      </ul>

      <div class="mt-9 flex flex-wrap items-center gap-5">
        <a href={href} rel="noopener" class="inline-block transition-opacity hover:opacity-90">
          <img src={badge} alt={a.cta} width="180" height="70" loading="lazy" decoding="async" />
        </a>
        <a
          href={appPagePath(lang)}
          class="text-sm font-semibold text-brand-300 underline-offset-4 transition-colors hover:text-brand-200 hover:underline"
        >
          {a.more} &rarr;
        </a>
      </div>
      <p class="mt-5 text-xs text-ink-500">{a.note}</p>
    </div>

    <div class="relative flex justify-center lg:justify-end">
      <div class="flex items-center">
        <PhoneMock lang={lang} screen="books" class="z-10 -mr-16 hidden rotate-[-4deg] sm:block" />
        <PhoneMock lang={lang} screen="detail" class="z-20 rotate-[3deg]" />
      </div>
    </div>
  </div>
</section>
