---
// Hero showpiece — a faithful, localized recreation of the top of the app
// (the "My Books" dashboard at app.inkmagnet.com/dashboard).
import { useTranslations, type Lang } from "../../i18n/ui";
import BookCover from "./BookCover.astro";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const m = t.mock;
const labels = { done: m.statusDone, writing: m.statusWriting, pagesWord: m.pagesWord };
const heroBooks = m.books.slice(0, 4);
---

<div class="relative" aria-hidden="true">
  <div class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-2xl shadow-ink-900/15 ring-1 ring-ink-900/5">
    {/* browser chrome */}
    <div class="flex items-center gap-1.5 border-b border-ink-100 bg-ink-50 px-3 py-2.5">
      <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
      <span class="ml-2 flex h-5 min-w-0 flex-1 items-center rounded bg-white px-2 text-[10px] font-medium text-ink-400 ring-1 ring-ink-100">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1 h-2.5 w-2.5 flex-shrink-0 text-ink-300"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 13.5v6a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
        <span class="truncate">{m.urlDashboard}</span>
      </span>
    </div>

    {/* app top bar */}
    <div class="flex items-center justify-between border-b border-ink-100 px-3 py-2 sm:px-4 sm:py-2.5">
      <span class="flex items-center gap-1.5 font-display text-[12px] font-extrabold text-ink-900 sm:text-[13px]">
        <span class="flex h-5 w-5 items-center justify-center rounded-md bg-gradient-to-br from-brand-500 to-brand-700">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3 w-3 text-white"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.25c-1.6-1-3.8-1.5-6-1.5-1 0-1.9.1-2.8.3v12.7c.9-.2 1.8-.3 2.8-.3 2.2 0 4.4.5 6 1.5m0-12.7c1.6-1 3.8-1.5 6-1.5 1 0 1.9.1 2.8.3v12.7c-.9-.2-1.8-.3-2.8-.3-2.2 0-4.4.5-6 1.5m0-12.7v12.7" /></svg>
        </span>
        InkMagnet
      </span>
      <span class="flex items-center gap-2">
        <span class="hidden items-center gap-1.5 rounded-full bg-ink-50 px-2 py-1 text-[9px] font-semibold text-ink-500 ring-1 ring-ink-100 sm:inline-flex">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-2.5 w-2.5 text-emerald-500"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.25c-1.6-1-3.8-1.5-6-1.5-1 0-1.9.1-2.8.3v12.7c.9-.2 1.8-.3 2.8-.3 2.2 0 4.4.5 6 1.5m0-12.7c1.6-1 3.8-1.5 6-1.5 1 0 1.9.1 2.8.3v12.7c-.9-.2-1.8-.3-2.8-.3-2.2 0-4.4.5-6 1.5m0-12.7v12.7" /></svg>
          12
        </span>
        <span class="hidden h-6 w-6 rounded-full bg-gradient-to-br from-brand-400 to-brand-600 ring-2 ring-white sm:block"></span>
      </span>
    </div>

    {/* content */}
    <div class="bg-gradient-to-b from-white to-ink-50/40 p-3 sm:p-4">
      <div class="mb-3 flex items-center justify-between gap-2">
        <span class="flex min-w-0 items-center gap-2">
          <h3 class="truncate font-display text-sm font-extrabold text-ink-900 sm:text-[15px]">{m.dashTitle}</h3>
          <span class="flex-shrink-0 rounded-full bg-ink-100 px-1.5 py-0.5 text-[9px] font-semibold text-ink-500">12</span>
        </span>
        <span class="inline-flex flex-shrink-0 items-center gap-1 whitespace-nowrap rounded-lg bg-violet-600 px-2.5 py-1.5 text-[10px] font-bold text-white shadow-sm shadow-violet-600/30">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="h-3 w-3"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          <span class="sm:hidden">{m.newBookShort}</span>
          <span class="hidden sm:inline">{m.newBook}</span>
        </span>
      </div>

      <div class="grid grid-cols-2 gap-3">
        {heroBooks.map((book, i) => <BookCover book={book} idx={i} labels={labels} />)}
      </div>
    </div>
  </div>

  {/* floating PDF · EPUB chip */}
  <div class="absolute -bottom-3 left-1/2 flex -translate-x-1/2 items-center gap-2 rounded-full border border-ink-100 bg-white px-4 py-2 text-xs font-semibold text-ink-700 shadow-lg">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 text-brand-600"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
    PDF · EPUB
  </div>
</div>
