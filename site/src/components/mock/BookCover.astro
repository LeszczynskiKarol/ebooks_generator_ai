---
// One book-cover card for the dashboard mockups (hero + app showcase).
// Mirrors the real app's "photo banner" cover: a full-bleed FLUX background
// photo with a dark gradient scrim baked into the lower half, and the title /
// author set over the lower third. Backgrounds live in public/covers/*.webp
// (optimized, ~7-40 KB each) and are shared across locales — only the overlaid
// title text differs by language (from t.mock).
interface Book {
  title: string;
  author: string;
  pages: number;
  fmt: string;
  status: string;
  pct?: number;
}
interface Props {
  book: Book;
  idx: number;
  labels: { done: string; writing: string; pagesWord: string };
}
const { book, idx, labels } = Astro.props;

const COVER_COUNT = 8;
const cover = `/covers/cover-${(idx % COVER_COUNT) + 1}.webp`;
const writing = book.status === "writing";
---

<div class="overflow-hidden rounded-lg border border-ink-100 bg-white shadow-sm">
  <div class="relative aspect-[3/4] overflow-hidden">
    {/* FLUX background photo */}
    <img
      src={cover}
      alt=""
      loading="lazy"
      decoding="async"
      draggable="false"
      class="absolute inset-0 h-full w-full object-cover"
    />
    {/* dark scrim for title legibility (baked into the lower half on real covers) */}
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/5"></div>

    <div class="relative flex h-full flex-col justify-between p-3">
      {/* status badge */}
      <span class={`inline-flex w-fit items-center gap-1 rounded-full px-1.5 py-0.5 text-[7px] font-bold backdrop-blur-sm ${writing ? "bg-white/90 text-violet-700" : "bg-white/90 text-emerald-700"}`}>
        <span class={`h-1 w-1 rounded-full ${writing ? "animate-pulse bg-violet-500" : "bg-emerald-500"}`}></span>
        {writing ? labels.writing : labels.done}
      </span>

      {/* title block over the scrim */}
      <div>
        <span class="mb-1.5 block h-px w-7 bg-white/60"></span>
        <p class="font-serif text-[11px] font-bold leading-[1.15] text-white [text-shadow:0_1px_6px_rgba(0,0,0,0.5)] [text-wrap:balance] line-clamp-3">
          {book.title}
        </p>
        <p class="mt-1 text-[7.5px] uppercase tracking-wide text-white/80">{book.author}</p>
      </div>
    </div>

    {/* generation progress overlay */}
    {
      writing && (
        <div class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-black/80 to-transparent p-2 pt-5">
          <div class="mb-1 flex items-center justify-between">
            <span class="text-[7px] font-medium text-white/90">{labels.writing}</span>
            <span class="text-[7px] font-bold text-white">{book.pct}%</span>
          </div>
          <div class="h-1 overflow-hidden rounded-full bg-white/25">
            <div class="h-full rounded-full bg-white" style={`width:${book.pct}%`}></div>
          </div>
        </div>
      )
    }
  </div>

  <div class="flex items-center justify-between px-2.5 py-1.5">
    <span class="text-[8.5px] text-ink-400">{book.pages} {labels.pagesWord} · {book.fmt}</span>
    <span class="h-1 w-1 rounded-full bg-ink-200"></span>
  </div>
</div>
