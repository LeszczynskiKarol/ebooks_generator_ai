---
// Localized mockup of the in-app book editor (BookEditor + WysiwygEditor):
// chapter rail + rich-text toolbar + editable canvas with a heading, prose, a
// callout box and a styled table. Copy comes from t.mock (book content) and
// t.mock.editor (UI labels). App accent = violet-600.
import { useTranslations, type Lang } from "../../i18n/ui";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const m = useTranslations(lang).mock;
const e = m.editor;
const book = m.book;

// toolbar icon paths (lucide-ish)
const tools = [
  "M9 14 4 9l5-5", // undo
  "m15 14 5-5-5-5", // redo
  "M6 4h12M6 4v16M18 4v16", // heading-ish
  "M6 12h12M4 6h16M4 18h16", // text
  "M7 5h7a3.5 3.5 0 0 1 0 7H7zM7 12h8a3.5 3.5 0 0 1 0 7H7z", // bold
  "M19 4h-9M14 20H5M15 4 9 20", // italic
  "M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01", // list
  "M4 6h16M4 12h16M4 18h7", // hr
  "M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z", // callout
  "M3 9h18M3 15h18M9 3v18M15 3v18", // table
  "M3 16.5 8 11l4.5 4.5L16 12l5 5M3.75 19.5h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Z", // image
];
---

<div class="overflow-hidden rounded-xl border border-ink-200 bg-white shadow-lg shadow-ink-900/5" data-zoom aria-hidden="true">
  <!-- chrome -->
  <div class="flex items-center gap-1.5 border-b border-ink-100 bg-ink-50 px-3 py-2.5">
    <span class="h-2 w-2 rounded-full bg-ink-200"></span>
    <span class="h-2 w-2 rounded-full bg-ink-200"></span>
    <span class="h-2 w-2 rounded-full bg-ink-200"></span>
    <span class="ml-2 flex h-5 flex-1 items-center rounded bg-white px-2 text-[9px] font-medium text-ink-400 ring-1 ring-ink-100">
      {m.urlProject}
    </span>
  </div>

  <div class="grid grid-cols-[120px_1fr] sm:grid-cols-[150px_1fr]">
    <!-- chapter rail -->
    <aside class="border-r border-ink-100 bg-ink-50/60 p-2">
      <p class="px-1.5 pb-1.5 text-[8px] font-bold uppercase tracking-wide text-ink-400">{e.heading}</p>
      <div class="space-y-0.5">
        {book.chapters.map((c, i) => (
          <div class={`flex items-center gap-1.5 rounded-md px-1.5 py-1.5 ${i === 2 ? "bg-violet-50 ring-1 ring-violet-100" : ""}`}>
            <span class={`text-[7px] font-bold ${i === 2 ? "text-violet-600" : "text-ink-400"}`}>{c.n}</span>
            <span class={`flex-1 truncate text-[9px] ${i === 2 ? "font-semibold text-violet-700" : "text-ink-600"}`}>{c.title}</span>
            {i === 0 || i === 1 ? (
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-2.5 w-2.5 flex-shrink-0 text-green-500"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L4.3 10.7a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" /></svg>
            ) : i === 2 ? (
              <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-amber-400"></span>
            ) : null}
          </div>
        ))}
      </div>
    </aside>

    <!-- editor pane -->
    <div class="min-w-0">
      <!-- toolbar -->
      <div class="flex items-center justify-between border-b border-ink-100 bg-white px-2 py-1.5">
        <div class="flex flex-wrap items-center gap-0.5">
          {tools.map((d, i) => (
            <>
              {(i === 2 || i === 4 || i === 6 || i === 8) && <span class="mx-0.5 h-3.5 w-px bg-ink-200"></span>}
              <span class="flex h-6 w-6 items-center justify-center rounded text-ink-500 hover:bg-ink-100">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5"><path stroke-linecap="round" stroke-linejoin="round" d={d} /></svg>
              </span>
            </>
          ))}
        </div>
        <div class="hidden items-center gap-1 rounded-md bg-ink-100 p-0.5 sm:flex">
          <span class="rounded bg-white px-2 py-0.5 text-[9px] font-semibold text-ink-700 shadow-sm">{e.visual}</span>
          <span class="px-2 py-0.5 text-[9px] font-medium text-ink-400">{e.code}</span>
        </div>
      </div>

      <!-- canvas -->
      <div class="space-y-2.5 p-4 font-serif">
        <p class="text-[7px] font-bold uppercase tracking-[0.2em] text-violet-500">{m.book.chapterLabel}</p>
        <h4 class="text-[15px] font-bold leading-tight text-ink-900">{book.chapterTitle}</h4>
        <p class="text-[9px] leading-[1.6] text-ink-700">{book.dropcap}{book.body}</p>
        <!-- callout box (editable) -->
        <div class="rounded-r border-l-2 border-violet-400 bg-violet-50 px-3 py-2">
          <p class="text-[7px] font-bold uppercase tracking-wide text-violet-600">{book.insightLabel}</p>
          <p class="mt-0.5 text-[8.5px] leading-[1.5] text-ink-700">{book.insightText}</p>
        </div>
        <p class="text-[9px] leading-[1.6] text-ink-700">{book.body2}</p>
      </div>

      <!-- save bar -->
      <div class="flex items-center justify-between border-t border-ink-100 bg-ink-50/60 px-3 py-2">
        <span class="flex items-center gap-1.5 text-[9px] font-medium text-amber-600">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
          {e.unsaved}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-lg bg-violet-600 px-3 py-1.5 text-[10px] font-bold text-white shadow-sm shadow-violet-600/30">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3 w-3"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2zM17 21v-8H7v8M7 3v5h8" /></svg>
          {e.save}
        </span>
      </div>
    </div>
  </div>
</div>
