---
// A localized recreation of the three main screens of the Android app
// (com.inkmagnet.app). The real Play screenshots exist only in Polish, so the
// screens are drawn in HTML instead — same approach as the web-app mocks next
// door, and it keeps EN and PL in sync for free.
import { useTranslations, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
  screen: "books" | "create" | "detail";
  class?: string;
}
const { lang, screen, class: cls = "" } = Astro.props;
const p = useTranslations(lang).phone;
const dark = screen === "books";
// the language pill the app pre-selects mirrors the interface language
const langIdx = lang === "pl" ? 1 : 0;
---

{/* text-left: the callers centre their captions, and that must not leak into
    the app UI inside the frame */}
<div class={`relative w-[230px] flex-shrink-0 text-left ${cls}`} aria-hidden="true">
  <div class="rounded-[2.1rem] bg-ink-900 p-[6px] shadow-2xl shadow-ink-900/30 ring-1 ring-ink-900/10">
    <div
      class={`relative h-[468px] overflow-hidden rounded-[1.7rem] ${dark ? "bg-[#0b1220]" : "bg-[#f7f8fb]"}`}
    >
      {/* status bar */}
      <div
        class={`flex items-center justify-between px-4 pb-1 pt-2.5 text-[8.5px] font-bold ${dark ? "text-ink-400" : "text-ink-500"}`}
      >
        <span>{p.time}</span>
        <span class="flex items-center gap-[3px]">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-2 w-2"
            ><path d="M12 18.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3ZM4 11.2a11.3 11.3 0 0 1 16 0l-2 2a8.5 8.5 0 0 0-12 0l-2-2ZM8 15.2a5.6 5.6 0 0 1 8 0l-2 2a2.8 2.8 0 0 0-4 0l-2-2Z"
            ></path></svg
          >
          <span class="inline-block h-[7px] w-[13px] rounded-[2px] border border-current"></span>
        </span>
      </div>

      {/* ── My Books ───────────────────────────────────────────── */}
      {
        screen === "books" && (
          <div class="px-3.5 pt-2">
            <h3 class="font-display text-[17px] font-extrabold tracking-tight text-white">
              {p.books.title}
            </h3>
            <div class="mt-3 space-y-2.5">
              {p.books.items.map((b) => (
                <div class="rounded-xl bg-white/[0.045] p-2.5 ring-1 ring-white/[0.06]">
                  <div class="flex items-center gap-2.5">
                    <span class="flex h-[44px] w-[32px] flex-shrink-0 items-center justify-center rounded-[5px] bg-gradient-to-br from-violet-500/80 to-violet-800">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5 text-white/90">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.25c-1.6-1-3.8-1.5-6-1.5-1 0-1.9.1-2.8.3v12.7c.9-.2 1.8-.3 2.8-.3 2.2 0 4.4.5 6 1.5m0-12.7c1.6-1 3.8-1.5 6-1.5 1 0 1.9.1 2.8.3v12.7c-.9-.2-1.8-.3-2.8-.3-2.2 0-4.4.5-6 1.5m0-12.7v12.7" />
                      </svg>
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-[10.5px] font-bold leading-tight text-white">
                        {b.title}
                      </span>
                      <span class="mt-[3px] block truncate text-[9px] text-ink-400">{b.meta}</span>
                      <span
                        class={`mt-[5px] inline-block rounded-full px-2 py-[2px] text-[8.5px] font-semibold ${
                          b.state === "done"
                            ? "bg-emerald-500/15 text-emerald-400"
                            : "bg-amber-500/15 text-amber-300"
                        }`}
                      >
                        {b.status}
                      </span>
                    </span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" class="h-3 w-3 flex-shrink-0 text-ink-500">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
                    </svg>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {/* ── New book ───────────────────────────────────────────── */}
      {
        screen === "create" && (
          <div class="px-3.5 pt-2">
            <h3 class="font-display text-[17px] font-extrabold tracking-tight text-ink-900">
              {p.create.title}
            </h3>

            <p class="mt-3 text-[9.5px] font-medium text-ink-600">{p.create.topicLabel}</p>
            <div class="mt-1 h-[44px] rounded-xl border border-ink-200 bg-white px-2.5 py-1.5 text-[9.5px] leading-[1.35] text-ink-400">
              {p.create.topicPlaceholder}
            </div>

            <p class="mt-2.5 text-[9.5px] font-medium text-ink-600">{p.create.titleLabel}</p>
            <div class="mt-1 h-[26px] rounded-xl border border-ink-200 bg-white" />

            <p class="mt-3 text-[10.5px] font-bold text-ink-900">{p.create.langLabel}</p>
            <div class="mt-1.5 flex gap-2">
              {p.create.langs.map((l, i) => (
                <span
                  class={
                    i === langIdx
                      ? "rounded-full bg-violet-600 px-3 py-[5px] text-[9.5px] font-semibold text-white"
                      : "rounded-full border border-ink-200 bg-white px-3 py-[5px] text-[9.5px] font-semibold text-ink-700"
                  }
                >
                  {l}
                </span>
              ))}
            </div>

            <p class="mt-3 text-[10.5px] font-bold text-ink-900">{p.create.sizeLabel}</p>
            <div class="mt-1.5 space-y-1.5">
              {p.create.sizes.map((sz, i) => (
                <div
                  class={`flex items-center justify-between rounded-xl px-2.5 py-1.5 ${
                    i === 1
                      ? "border border-violet-500 bg-violet-50"
                      : "border border-ink-200 bg-white"
                  }`}
                >
                  <span>
                    <span class="block text-[10px] font-bold text-ink-900">{sz.name}</span>
                    <span class="block text-[9px] text-ink-500">{sz.pages}</span>
                  </span>
                  {i === 1 && (
                    <span class="flex h-3.5 w-3.5 items-center justify-center rounded-full bg-violet-600">
                      <svg viewBox="0 0 20 20" fill="currentColor" class="h-2.5 w-2.5 text-white">
                        <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L4.3 10.7a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  )}
                </div>
              ))}
            </div>
          </div>
        )
      }

      {/* ── Book detail ────────────────────────────────────────── */}
      {
        screen === "detail" && (
          <div class="px-3.5 pt-1.5">
            <div class="flex items-center gap-2 border-b border-ink-200/70 pb-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="h-3.5 w-3.5 text-ink-700">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 5 8 12l7 7" />
              </svg>
              <span class="truncate font-display text-[11.5px] font-extrabold text-ink-900">
                {p.detail.title}
              </span>
            </div>

            <div class="mt-3 flex gap-2.5">
              <span class="flex h-[54px] w-[40px] flex-shrink-0 items-center justify-center rounded-[5px] bg-gradient-to-br from-violet-500 to-violet-800">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 text-white/90">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.25c-1.6-1-3.8-1.5-6-1.5-1 0-1.9.1-2.8.3v12.7c.9-.2 1.8-.3 2.8-.3 2.2 0 4.4.5 6 1.5m0-12.7c1.6-1 3.8-1.5 6-1.5 1 0 1.9.1 2.8.3v12.7c-.9-.2-1.8-.3-2.8-.3-2.2 0-4.4.5-6 1.5m0-12.7v12.7" />
                </svg>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[11px] font-extrabold leading-tight text-ink-900">
                  {p.detail.title}
                </span>
                <span class="mt-1.5 inline-block rounded-full bg-emerald-100 px-2 py-[2px] text-[8.5px] font-semibold text-emerald-700">
                  {p.detail.status}
                </span>
              </span>
            </div>

            <div class="mt-3 rounded-xl border border-ink-200 bg-white p-2.5">
              <p class="text-[10px] font-bold text-ink-900">{p.detail.progressLabel}</p>
              <div class="mt-2 flex items-start justify-between">
                {p.detail.steps.map((st) => (
                  <span class="flex w-[15%] flex-col items-center gap-1">
                    <span class="flex h-[15px] w-[15px] items-center justify-center rounded-full bg-violet-600">
                      <svg viewBox="0 0 20 20" fill="currentColor" class="h-2.5 w-2.5 text-white">
                        <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L4.3 10.7a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                      </svg>
                    </span>
                    <span class="text-center text-[6px] font-semibold leading-[1.15] text-ink-500">
                      {st}
                    </span>
                  </span>
                ))}
              </div>
            </div>

            <div class="mt-2.5 rounded-xl border border-ink-200 bg-white p-2.5">
              <p class="text-[10px] font-bold text-ink-900">{p.detail.downloadLabel}</p>
              <span class="mt-2 flex h-[30px] items-center justify-center gap-1.5 rounded-lg bg-violet-600 text-[10.5px] font-bold text-white">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3 w-3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.6a3.4 3.4 0 0 0-1-2.4l-3.8-3.8a3.4 3.4 0 0 0-2.4-1H6.8a1.7 1.7 0 0 0-1.7 1.7v14.2a1.7 1.7 0 0 0 1.7 1.7h11a1.7 1.7 0 0 0 1.7-1.7v-2.6M14 4.5v3.4a1.7 1.7 0 0 0 1.7 1.7h3.4" />
                </svg>
                {p.detail.pdf}
              </span>
              <span class="mt-1.5 flex h-[30px] items-center justify-center gap-1.5 rounded-lg bg-ink-100 text-[10.5px] font-bold text-ink-800">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3 w-3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.25c-1.6-1-3.8-1.5-6-1.5-1 0-1.9.1-2.8.3v12.7c.9-.2 1.8-.3 2.8-.3 2.2 0 4.4.5 6 1.5m0-12.7c1.6-1 3.8-1.5 6-1.5 1 0 1.9.1 2.8.3v12.7c-.9-.2-1.8-.3-2.8-.3-2.2 0-4.4.5-6 1.5m0-12.7v12.7" />
                </svg>
                {p.detail.epub}
              </span>
              <span class="mt-2 flex items-center gap-1.5 text-[9.5px] font-semibold leading-tight text-violet-700">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3 w-3 flex-shrink-0">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.7A1.7 1.7 0 0 0 4 7.7v10.6A1.7 1.7 0 0 0 5.7 20h10.6a1.7 1.7 0 0 0 1.7-1.7v-7.8M14 4h6v6M20 4l-8.5 8.5" />
                </svg>
                {p.detail.webLink}
              </span>
            </div>
          </div>
        )
      }
    </div>
  </div>
</div>
