---
// Realistic, localized mockups of a typeset book page (the actual output).
// kind: 0=contents, 1=chapter opening (drop cap), 2=table + insight box,
// 3=figure/illustration with caption. Content comes from t.mock.book so PL and
// EN render their own language.
import { useTranslations, type Lang } from "../../i18n/ui";
interface Props {
  kind: number;
  lang: Lang;
}
const { kind, lang } = Astro.props;
const b = useTranslations(lang).mock.book;
---

<div class="aspect-[3/4] w-full overflow-hidden bg-white px-5 py-5 font-serif">
  {/* 0 — Table of contents */}
  {
    kind === 0 && (
      <div class="flex h-full flex-col">
        <p class="text-[14px] font-bold tracking-tight text-ink-900">{b.tocTitle}</p>
        <span class="mb-3 mt-1.5 block h-0.5 w-8 bg-brand-500" />
        <div class="space-y-[7px]">
          {b.toc.map((e) => (
            <div class="flex items-baseline gap-1.5">
              <span class="truncate text-[8.5px] text-ink-700">{e.label}</span>
              <span class="mb-[2px] flex-1 border-b border-dotted border-ink-300" />
              <span class="text-[8.5px] tabular-nums text-ink-500">{e.page}</span>
            </div>
          ))}
        </div>
      </div>
    )
  }

  {/* 1 — Chapter opening with drop cap */}
  {
    kind === 1 && (
      <div class="flex h-full flex-col">
        <p class="text-[7px] font-bold uppercase tracking-[0.22em] text-brand-600">
          {b.chapterLabel}
        </p>
        <h3 class="mb-2.5 mt-1 text-[14px] font-bold leading-[1.15] text-ink-900 [text-wrap:balance]">
          {b.chapterTitle}
        </h3>
        <p class="text-justify text-[8px] leading-[1.55] text-ink-700">
          <span class="float-left mr-1.5 mt-0.5 font-bold text-brand-600 [font-size:30px] [line-height:0.78]">
            {b.dropcap}
          </span>
          {b.body}
        </p>
        <p class="mt-2 text-justify text-[8px] leading-[1.55] text-ink-700">{b.body2}</p>
      </div>
    )
  }

  {/* 2 — Styled table + insight box */}
  {
    kind === 2 && (
      <div class="flex h-full flex-col">
        <p class="mb-2 text-[8px] font-bold text-ink-800">{b.tableTitle}</p>
        <div class="overflow-hidden rounded border border-ink-200">
          <div class="flex bg-brand-600 text-[7px] font-semibold text-white">
            {b.tableCols.map((c, i) => (
              <span class={i === 0 ? "flex-1 px-2 py-1.5" : "w-[58px] px-2 py-1.5 text-right"}>
                {c}
              </span>
            ))}
          </div>
          {b.tableRows.map((row, ri) => (
            <div class={`flex border-t border-ink-100 text-[7px] ${ri % 2 ? "bg-ink-50" : "bg-white"}`}>
              {row.map((cell, ci) => (
                <span class={ci === 0 ? "flex-1 px-2 py-1.5 text-ink-700" : "w-[58px] px-2 py-1.5 text-right text-ink-600"}>
                  {cell}
                </span>
              ))}
            </div>
          ))}
        </div>
        <div class="mt-2.5 rounded-r border-l-2 border-brand-500 bg-brand-50 px-2.5 py-2">
          <p class="text-[6.5px] font-bold uppercase tracking-wide text-brand-600">
            {b.insightLabel}
          </p>
          <p class="mt-0.5 text-[7px] leading-[1.5] text-ink-700">{b.insightText}</p>
        </div>
      </div>
    )
  }

  {/* 3 — Figure / illustration with caption */}
  {
    kind === 3 && (
      <div class="flex h-full flex-col">
        <p class="mb-2.5 text-justify text-[8px] leading-[1.55] text-ink-700">{b.body2}</p>
        {/* pricing-ladder figure */}
        <div class="relative overflow-hidden rounded-md bg-gradient-to-br from-brand-50 via-ink-50 to-brand-100 p-3">
          <div class="flex h-[88px] items-end justify-center gap-2.5">
            {[
              { h: "42%", price: "$0", g: "from-brand-300 to-brand-400" },
              { h: "66%", price: "$29", g: "from-brand-400 to-brand-500" },
              { h: "94%", price: "$99", g: "from-brand-500 to-brand-700" },
            ].map((bar) => (
              <div class="flex h-full w-9 flex-col items-center justify-end">
                <span class="mb-1 rounded-sm bg-white px-1 py-0.5 text-[6.5px] font-bold text-brand-700 shadow-sm">
                  {bar.price}
                </span>
                <div class={`w-full rounded-t bg-gradient-to-b ${bar.g}`} style={`height:${bar.h}`} />
              </div>
            ))}
          </div>
          <span class="block border-t border-ink-300/60" />
        </div>
        <p class="mt-1.5 text-[7px] italic leading-snug text-ink-500">{b.figCaption}</p>
        <p class="mt-2 line-clamp-3 text-justify text-[8px] leading-[1.55] text-ink-700">{b.body}</p>
      </div>
    )
  }
</div>
