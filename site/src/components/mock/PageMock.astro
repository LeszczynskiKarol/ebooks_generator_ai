---
// Code mockup of a typeset book page. kind: 0=TOC, 1=chapter, 2=table, 3=illustration.
// Language-neutral (bars) so it renders the same on every locale.
interface Props {
  kind: number;
}
const { kind } = Astro.props;
---

<div class="aspect-[3/4] w-full bg-white p-5 [font-size:0]">
  {/* 0 — Table of contents */}
  {
    kind === 0 && (
      <div class="flex h-full flex-col">
        <div class="mb-4 h-3 w-2/3 rounded bg-ink-300" />
        <div class="space-y-3">
          {[20, 14, 24, 18, 16, 22, 12].map((p, idx) => (
            <div class="flex items-baseline gap-2">
              <span class="h-2 rounded bg-ink-200" style={`width:${[42, 55, 38, 60, 48, 35, 52][idx]}%`} />
              <span class="mb-0.5 flex-1 border-b border-dotted border-ink-200" />
              <span class="h-2 w-4 rounded bg-ink-200" />
            </div>
          ))}
        </div>
      </div>
    )
  }

  {/* 1 — Chapter opening with drop cap */}
  {
    kind === 1 && (
      <div class="flex h-full flex-col">
        <div class="mb-1 h-2 w-10 rounded bg-brand-300" />
        <div class="mb-4 h-3.5 w-4/5 rounded bg-ink-300" />
        <div class="flex gap-2">
          <div class="h-12 w-12 flex-shrink-0 rounded bg-brand-600" />
          <div class="flex-1 space-y-1.5 pt-0.5">
            <div class="h-2 w-full rounded bg-ink-100" />
            <div class="h-2 w-full rounded bg-ink-100" />
            <div class="h-2 w-11/12 rounded bg-ink-100" />
          </div>
        </div>
        <div class="mt-2 space-y-1.5">
          {[100, 100, 95, 100, 88, 100, 70].map((w) => (
            <div class="h-2 rounded bg-ink-100" style={`width:${w}%`} />
          ))}
        </div>
      </div>
    )
  }

  {/* 2 — Styled table + insight box */}
  {
    kind === 2 && (
      <div class="flex h-full flex-col">
        <div class="mb-3 h-2.5 w-1/2 rounded bg-ink-300" />
        <div class="overflow-hidden rounded border border-ink-200">
          <div class="flex bg-brand-600 px-2 py-1.5">
            {[30, 22, 26].map((w) => (
              <span class="mr-3 h-1.5 rounded bg-white/80" style={`width:${w}px`} />
            ))}
          </div>
          {[0, 1, 2, 3].map((r) => (
            <div class={`flex px-2 py-1.5 ${r % 2 ? "bg-ink-50" : "bg-white"}`}>
              {[34, 18, 24].map((w) => (
                <span class="mr-3 h-1.5 rounded bg-ink-200" style={`width:${w}px`} />
              ))}
            </div>
          ))}
        </div>
        <div class="mt-3 rounded-r border-l-4 border-brand-500 bg-brand-50 p-2.5">
          <div class="mb-1.5 h-1.5 w-12 rounded bg-brand-400" />
          <div class="space-y-1">
            <div class="h-1.5 w-full rounded bg-ink-200" />
            <div class="h-1.5 w-4/5 rounded bg-ink-200" />
          </div>
        </div>
      </div>
    )
  }

  {/* 3 — AI illustration with caption */}
  {
    kind === 3 && (
      <div class="flex h-full flex-col">
        <div class="mb-3 space-y-1.5">
          <div class="h-2 w-full rounded bg-ink-100" />
          <div class="h-2 w-11/12 rounded bg-ink-100" />
        </div>
        <div class="relative flex-1 overflow-hidden rounded-lg bg-gradient-to-br from-ink-200 via-ink-100 to-brand-100">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" class="absolute bottom-2 right-2 h-6 w-6 text-ink-400">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5 8 11l4.5 4.5L16 12l5 5M3.75 19.5h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Z" />
          </svg>
        </div>
        <div class="mt-2 h-1.5 w-2/3 rounded bg-ink-200" />
        <div class="mt-3 space-y-1.5">
          {[100, 92, 100, 78].map((w) => (
            <div class="h-2 rounded bg-ink-100" style={`width:${w}%`} />
          ))}
        </div>
      </div>
    )
  }
</div>
