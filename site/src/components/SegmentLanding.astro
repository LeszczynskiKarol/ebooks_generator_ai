---
// Segment landing ("ebook for a service business", "for coaches"...): the
// segment's own copy (data/segments/*.ts) + the REAL example book made for
// that audience (table of contents, page previews, free PDF) + real app
// screens. Wrapped by a page in src/pages that passes one Segment.
import { siteConfig } from "../config/site";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Shot from "./Shot.astro";
import Lightbox from "./Lightbox.astro";
import { examples } from "../data/examples.js";
import pagesData from "../data/examplePages.json";
import type { Segment } from "../data/segments/types";

interface Props {
  seg: Segment;
}
const { seg } = Astro.props;
const pl = seg.lang === "pl";
const registerUrl = `${siteConfig.appUrl}/auth/register?lang=${seg.lang}`;
const book = (examples as any[]).find((b) => b.slug === seg.exampleSlug);
const extra = (pagesData as Record<string, { toc: { title: string; sections: string[] }[]; pages: string[]; previewFrom: number }>)[seg.exampleSlug];
if (!book || !extra) throw new Error(`Segment ${seg.key}: example ${seg.exampleSlug} missing in examples.js / examplePages.json`);
const bookHref = pl ? `/pl/przyklady/${book.slug}/` : `/examples/${book.slug}/`;
const pdfHref = `/samples/${book.slug}.pdf`;
// pages[0] is the cover (already shown next to the TOC), previews start inside
const pageImgs = extra.pages.slice(1).map((p) => `/samples/pages/${book.slug}/${p}`);
const shotDir = pl ? "/app/pl" : "/app/en";
const phoneH = pl ? 831 : 767;
const howShots = [
  { web: "w-new", wh: 705, url: "app.inkmagnet.com/projects/new" },
  { web: "w-plan", wh: 625, phone: "m-plan", url: "app.inkmagnet.com/projects/…" },
  { web: "w-sample", wh: 831, url: pl ? "app.inkmagnet.com: próbka 2 stron" : "app.inkmagnet.com: 2-page sample" },
  { web: "w-download", wh: 391, phone: "m-book", url: "app.inkmagnet.com/projects/…" },
];
const l = pl
  ? { exBadge: "Prawdziwa książka z InkMagnet", pages: "stron", download: "Pobierz cały PDF za darmo", bookPage: "Zobacz stronę książki", toc: "Spis treści", faq: "Najczęstsze pytania", check: "Zaplanuj książkę za darmo", note: "Spis treści i próbka 2 stron są za darmo. Płacisz dopiero za gotową książkę." }
  : { exBadge: "A real book made with InkMagnet", pages: "pages", download: "Download the full PDF free", bookPage: "See the book page", toc: "Table of contents", faq: "Frequently asked questions", check: "Plan my book for free", note: "The table of contents and a 2-page sample are free. You pay only for the finished book." };
// Segment pages lead with their matching example PDF; generic pages
// (e.g. "generator książek") lead with creating a book.
const createFirst = seg.heroPrimary === "create";
const galleryHref = pl ? "/pl/przyklady/" : "/examples/";
const btnPrimary = "inline-flex items-center gap-2 rounded-xl bg-brand-600 px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25 transition-colors hover:bg-brand-700";
const btnSecondary = "inline-flex items-center gap-2 rounded-xl border border-ink-200 bg-white px-7 py-3.5 text-base font-semibold text-ink-700 transition-colors hover:bg-ink-50";
const dlIcon = "";
const check = "M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L4.3 10.7a1 1 0 1 1 1.4-1.4l2.8 2.8 6.8-6.8a1 1 0 0 1 1.4 0Z";
---

<Header lang={seg.lang} />

<main class="pt-16">
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_30rem_at_70%_-10%,theme(colors.brand.100),transparent)]" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl gap-12 px-4 pb-20 pt-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:gap-10 lg:px-8 lg:pb-24 lg:pt-20">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-600" aria-hidden="true"></span>{seg.hero.badge}
        </p>
        <h1 class="mt-5 font-display text-4xl font-extrabold leading-[1.1] tracking-tight text-ink-900 sm:text-5xl">
          {seg.hero.title} <span class="text-brand-600">{seg.hero.accent}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-600">{seg.hero.sub}</p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          {createFirst ? (
            <>
              <a href={registerUrl} class={btnPrimary}>{pl ? "Stwórz własną książkę" : "Create your own book"}</a>
              <a href={galleryHref} class={btnSecondary}>{pl ? "Zobacz przykładowe książki" : "See example books"}</a>
            </>
          ) : (
            <>
              <a href={pdfHref} class={btnPrimary}>{dlIcon}{l.download}</a>
              <a href={registerUrl} class={btnSecondary}>{pl ? "Stwórz własną książkę" : "Create your own book"}</a>
            </>
          )}
        </div>
        <ul class="mt-8 grid gap-2 text-sm text-ink-600 sm:grid-cols-2">
          {seg.hero.bullets.map((b) => (
            <li class="flex items-start gap-2"><svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-600" aria-hidden="true"><path fill-rule="evenodd" d={check} clip-rule="evenodd" /></svg>{b}</li>
          ))}
        </ul>
      </div>
      <!-- generic page: real app screens; segment page: its example book -->
      {createFirst ? (
        <div class="relative mx-auto w-full max-w-md pb-10 pl-8 sm:pl-14 lg:max-w-none">
          <Shot src={`${shotDir}/h-sample`} w={760} h={574} eager zoom={false} url={pl ? "app.inkmagnet.com: próbka książki" : "app.inkmagnet.com: book sample"} alt={pl ? "Próbka dwóch pierwszych stron książki" : "Two-page sample of a book"} />
          <Shot src={`${shotDir}/h-plan`} w={240} h={pl ? 511 : 472} kind="phone" eager zoom={false} class="absolute -bottom-2 left-0 w-[34%] max-w-[170px] rotate-[-3deg]" alt={pl ? "Plan książki w aplikacji na Androida" : "Book plan in the Android app"} />
        </div>
      ) : (
      <div class="relative mx-auto flex w-full max-w-md items-end justify-center gap-4 lg:max-w-none">
        <a href={bookHref} class="block w-[46%] max-w-[230px] -rotate-2 overflow-hidden rounded-lg shadow-2xl shadow-ink-900/25 ring-1 ring-ink-200 transition-transform hover:-rotate-1">
          <img src={`/samples/covers/${book.slug}.webp`} alt={book.title} width="520" height="738" loading="eager" fetchpriority="high" class="block h-auto w-full" />
        </a>
        <img src={pageImgs[Math.min(2, pageImgs.length - 1)]} alt={pl ? `Strona z książki „${book.title}”` : `A page from "${book.title}"`} width="760" height="1078" loading="eager" data-zoom class="block w-[46%] max-w-[230px] rotate-2 cursor-zoom-in rounded-lg bg-white shadow-xl shadow-ink-900/15 ring-1 ring-ink-200" />
      </div>
      )}
    </div>
  </section>

  <!-- Problem -->
  <section class="border-t border-ink-100">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:py-20">
      <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">{seg.problem.title}</h2>
      {seg.problem.paragraphs.map((p) => <p class="mt-5 text-lg leading-relaxed text-ink-600">{p}</p>)}
    </div>
  </section>

  <!-- Uses -->
  <section class="border-t border-ink-100 bg-ink-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">{seg.uses.title}</h2>
        <p class="mt-4 text-lg text-ink-600">{seg.uses.sub}</p>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {seg.uses.items.map((it) => (
          <div class="rounded-2xl border border-ink-100 bg-white p-6">
            <h3 class="font-display text-lg font-bold text-ink-900">{it.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-600">{it.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Example book: real TOC + pages + PDF (segment pages only) -->
  {!createFirst && (
  <>
  <section id="przyklad" class="scroll-mt-20 border-t border-ink-100">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="grid gap-12 lg:grid-cols-5 lg:gap-14">
        <div class="lg:col-span-2">
          <p class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">{l.exBadge}</p>
          <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-ink-900">{seg.inside.title}</h2>
          <p class="mt-4 text-lg leading-relaxed text-ink-600">{seg.inside.sub}</p>
          <a href={bookHref} class="mt-6 block overflow-hidden rounded-xl shadow-xl shadow-ink-900/15 ring-1 ring-ink-200">
            <img src={`/samples/covers/${book.slug}.webp`} alt={book.title} width="520" height="738" loading="lazy" decoding="async" class="block h-auto w-full" />
          </a>
          <p class="mt-4 text-sm text-ink-500">{book.title} · {book.pages} {l.pages}</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={pdfHref} class="rounded-xl bg-ink-900 px-5 py-3 text-sm font-semibold text-white hover:bg-ink-800">{l.download}</a>
            <a href={bookHref} class="rounded-xl border border-ink-200 px-5 py-3 text-sm font-semibold text-ink-700 hover:bg-ink-50">{l.bookPage}</a>
          </div>
        </div>
        <div class="lg:col-span-3">
          <h3 class="font-display text-xl font-bold text-ink-900">{l.toc}</h3>
          <ol class="mt-5 space-y-5">
            {extra.toc.map((ch, i) => (
              <li class="rounded-2xl border border-ink-100 bg-ink-50/60 p-5">
                <p class="font-display text-base font-bold text-ink-900"><span class="mr-2 text-brand-600">{i + 1}.</span>{ch.title}</p>
                {ch.sections.length > 0 && (
                  <ul class="mt-2 grid gap-x-6 gap-y-1 text-sm text-ink-600 sm:grid-cols-2">
                    {ch.sections.map((s) => <li>{s}</li>)}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Fragment: page previews -->
  <section class="border-t border-ink-100 bg-ink-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">{seg.fragment.title}</h2>
        <p class="mt-4 text-lg text-ink-600">{seg.fragment.sub}</p>
      </div>
      <div class="mt-12 grid grid-cols-2 gap-5 sm:grid-cols-3">
        {pageImgs.map((src, i) => (
          <img src={src} alt={pl ? `Strona ${i + 1} z podglądu książki „${book.title}”` : `Preview page ${i + 1} of "${book.title}"`} width="760" height="1078" loading="lazy" decoding="async" data-zoom class="block h-auto w-full cursor-zoom-in rounded-lg bg-white shadow-md shadow-ink-900/10 ring-1 ring-ink-200" />
        ))}
      </div>
    </div>
  </section>
  </>
  )}

  {seg.moreExamples && (
    <section class="border-t border-ink-100">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">{seg.moreExamples.title}</h2>
          <p class="mt-4 text-lg text-ink-600">{seg.moreExamples.sub}</p>
        </div>
        <div class="mt-10 grid grid-cols-3 gap-4 sm:grid-cols-4 lg:grid-cols-8">
          {seg.moreExamples.slugs
            .map((sl) => (examples as any[]).find((b) => b.slug === sl))
            .filter(Boolean)
            .map((b: any) => (
              <a href={pl ? `/pl/przyklady/${b.slug}/` : `/examples/${b.slug}/`} class="group block">
                <img src={`/samples/covers/${b.slug}.webp`} alt={b.title} width="520" height="738" loading="lazy" decoding="async" class="block h-auto w-full rounded-lg shadow-lg shadow-ink-900/15 ring-1 ring-ink-200 transition-transform group-hover:-translate-y-1" />
                <p class="mt-2 text-xs font-semibold leading-snug text-ink-900">{b.title}</p>
                <p class="text-xs text-ink-500">{b.pages} {l.pages}</p>
              </a>
            ))}
        </div>
        <p class="mt-10 text-center">
          <a href={galleryHref} class="font-semibold text-brand-700 underline-offset-4 hover:underline">{pl ? "Zobacz wszystkie przykładowe książki →" : "See all example books →"}</a>
        </p>
      </div>
    </section>
  )}

  <!-- How: real app screens -->
  <section class="border-t border-ink-100">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">{seg.how.title}</h2>
        <p class="mt-4 text-lg text-ink-600">{seg.how.sub}</p>
      </div>
      <ol class="mt-14 space-y-16">
        {seg.how.steps.map((step, i) => {
          const sh = howShots[i];
          return (
            <li class={`grid items-center gap-8 lg:grid-cols-2 lg:gap-14 ${i % 2 === 1 ? "lg:[&>div:first-child]:order-2" : ""}`}>
              <div>
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-600 font-display text-base font-bold text-white">{i + 1}</span>
                <h3 class="mt-4 font-display text-2xl font-bold text-ink-900">{step.title}</h3>
                <p class="mt-3 max-w-md leading-relaxed text-ink-600">{step.desc}</p>
              </div>
              {sh && (
                <div class:list={["relative", sh.phone && "pb-8 pr-6 sm:pr-16"]}>
                  <Shot src={`${shotDir}/${sh.web}`} w={1100} h={sh.wh} url={sh.url} alt={step.title} />
                  {sh.phone && <Shot src={`${shotDir}/${sh.phone}`} w={390} h={phoneH} kind="phone" class="absolute -bottom-2 right-0 w-[30%] max-w-[150px] rotate-[3deg]" alt={step.title} />}
                </div>
              )}
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <!-- Playbook -->
  <section class="border-t border-ink-100 bg-ink-50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">{seg.playbook.title}</h2>
        <p class="mt-4 text-lg text-ink-600">{seg.playbook.sub}</p>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {seg.playbook.items.map((it, i) => (
          <div class="flex gap-4 rounded-2xl border border-ink-100 bg-white p-6">
            <span class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-brand-50 font-display text-base font-bold text-brand-600">{i + 1}</span>
            <div>
              <h3 class="font-display text-lg font-bold text-ink-900">{it.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-ink-600">{it.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-ink-100">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:py-20">
      <h2 class="text-center font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">{l.faq}</h2>
      <div class="mt-10 space-y-4">
        {seg.faq.map((f) => (
          <details class="group rounded-2xl border border-ink-100 bg-white p-6 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-display text-base font-bold text-ink-900">{f.q}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 shrink-0 text-ink-400 transition-transform group-open:rotate-180" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
            </summary>
            <p class="mt-4 text-[15px] leading-relaxed text-ink-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="theme-fixed border-t border-ink-100 bg-ink-950">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:py-20">
      <h2 class="font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{seg.cta.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-300">{seg.cta.sub}</p>
      <a href={registerUrl} class="mt-8 inline-block rounded-xl bg-brand-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg shadow-brand-600/25 hover:bg-brand-700">{seg.cta.button}</a>
      <p class="mt-4 text-sm text-ink-400">{l.note}</p>
    </div>
  </section>
</main>

<Footer lang={seg.lang} />
<Lightbox />
