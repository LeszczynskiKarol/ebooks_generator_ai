generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?
  name         String?
  googleId     String? @unique
  avatarUrl    String?

  emailVerified DateTime? // null = registration not confirmed (Google logins auto-verify)
  authTokens    AuthToken[]

  stripeCustomerId String? @unique
  projects         Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Single-use auth secrets (6-digit codes / reset links). Only SHA256 hashes
// are stored; `attempts` guards brute-forcing of the short codes.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Project {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentStage ProjectStage @default(BRIEF)

  title       String?
  topic       String
  language    String  @default("en")
  authorName    String?   // Display name on title page
  subtitle      String?   // Custom subtitle (replaces default)
  guidelines  String? @db.Text
  targetPages Int
  stylePreset String  @default("modern")
  bookFormat  String  @default("a5")
  customColors  String?  @db.Text

  priceUsdCents   Int?
  currency        String        @default("usd")
  exchangeRate    Float?        // USD→PLN rate used at checkout (when currency = "pln")
  stripeSessionId String?
  stripePaymentId String?
  paymentStatus   PaymentStatus @default(PENDING)
  paidAt          DateTime?

  structure         ProjectStructure?
  structureRedoUsed Boolean @default(false)

  images      ProjectImage[]
  useAiImages Boolean        @default(false)
  imageGuidelines String?    @db.Text // optional user steering for AI illustrations
  imageDensity String        @default("standard") // standard (~1/5 pages) | rich (~1/3 pages)
  footnoteMode String        @default("auto") // auto (by style) | always | never

  chapters           Chapter[]
  generationStatus   GenerationStatus @default(NOT_STARTED)
  generationProgress Float            @default(0)

  colophonText     String?  @db.Text  
  colophonFontSize Int?     @default(10)
  colophonEnabled  Boolean  @default(false)

  outputPdfKey  String?
  outputEpubKey String?

  // ── Versioning ──
  currentVersion Int @default(0)
  versions       BookVersion[]

  researchData String? @db.Text

  totalTokensUsed Int   @default(0)
  totalCostUsd    Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([currentStage])

   coverType         CoverType @default(NONE)
   coverLatex        String?   @db.Text        // Generated LaTeX source for cover
   coverImageS3Key   String?                   // Custom uploaded cover image (S3 key)
   coverImageLocalPath String?                 // Custom uploaded cover image (local fallback)
   coverPdfS3Key     String?                   // Compiled cover PDF (S3 key)
   coverPdfLocalPath String?                   // Compiled cover PDF (local fallback)
   coverParams       String?   @db.Text        // JSON: layout, font overrides, etc.
   autoCoverRequested Boolean  @default(false)  // user ticked "Generate cover" in order form
   coverUpdatedAt    DateTime?                  // last cover mutation — compared against the newest BookVersion to detect "cover not yet in compiled PDF"
}

model BookVersion {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  version   Int
  s3Key     String?
  localPath String?
  fileSize  Int?
  pageCount Int?

  epubS3Key     String?
  epubLocalPath String?
  epubFileSize  Int?

  texS3Key     String?
  texLocalPath String?
  texFileSize  Int?

  coverPdfS3Key     String?
  coverPdfLocalPath String?


  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId])
}

enum CoverType {
  NONE
  GENERATED
  CUSTOM_UPLOAD
}

enum ProjectStage {
  BRIEF
  PRICING
  PAYMENT
  STRUCTURE
  STRUCTURE_REVIEW
  IMAGES
  GENERATING
  COMPILING
  COMPLETED
  ERROR
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum GenerationStatus {
  NOT_STARTED
  GENERATING_STRUCTURE
  STRUCTURE_READY
  GENERATING_CONTENT
  REVIEWING_CONTENT
  CONTENT_READY
  COMPILING_LATEX
  COMPILING_EPUB
  COMPLETED
  ERROR
}

model ProjectStructure {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  structureJson      String  @db.Text
  generationPrompt   String? @db.Text
  generationResponse String? @db.Text

  version      Int     @default(1)
  isUserEdited Boolean @default(false)

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Chapter {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterNumber Int
  title         String

  latexContent  String? @db.Text
  markdownDraft String? @db.Text

  targetPages Int
  actualPages Float?
  targetWords Int
  actualWords Int?

  writerPrompts   String? @db.Text
  writerResponses String? @db.Text
  researchData    String? @db.Text
  registryJson    String? @db.Text

  // Set when the user manually edits the chapter — regeneration must not overwrite it
  userEditedAt DateTime?

  imagePlacements ImagePlacement[]
  status          ChapterStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, chapterNumber])
  @@index([projectId])
}

enum ChapterStatus {
  PENDING
  GENERATING
  GENERATED
  LATEX_READY
  ERROR
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  source       ImageSource
  originalName String?
  s3Key        String
  s3Url        String?

  description      String? @db.Text
  suggestedContext String? @db.Text

  width  Int?
  height Int?
  format String?

  fluxPrompt String? @db.Text
  fluxSeed   Int?

  placements ImagePlacement[]
  createdAt  DateTime         @default(now())

  @@index([projectId])
}

enum ImageSource {
  USER_UPLOAD
  AI_GENERATED
  STOCK
}

model ImagePlacement {
  id        String       @id @default(cuid())
  chapterId String
  chapter   Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  imageId   String
  image     ProjectImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  position String
  caption  String?
  width    Float  @default(0.8)

  createdAt DateTime @default(now())

  @@index([chapterId])
}
