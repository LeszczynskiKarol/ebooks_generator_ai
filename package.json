{
  "name": "bookforge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend,tunnel -c green,cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:tunnel\"",
    "dev:local": "concurrently -k -n backend,frontend -c green,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:ollama": "concurrently -k -n backend,frontend,tunnel -c yellow,cyan,magenta \"npm:dev:backend:ollama\" \"npm:dev:frontend\" \"npm:dev:tunnel\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:backend:ollama": "cd backend && npm run dev:ollama",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:tunnel": "tunnel\\frpc.exe -c tunnel\\frpc.toml",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "db:push": "cd backend && npx prisma db push",
    "db:generate": "cd backend && npx prisma generate",
    "db:studio": "cd backend && npx prisma studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
